<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:plone="http://namespaces.plone.org/plone"
    xmlns:browser="http://namespaces.zope.org/browser">

  <!-- Includes existentes -->
  <include package=".publish" />
  <include package=".viewlets" />

  <!-- Recursos estáticos de impress -->
  <plone:static directory="static" type="plone" name="senaite.impress.static" />

  <!-- ========================================================= -->
  <!-- Tabla de resultados con estado/alertas (INFOLABSA) -->
  <browser:page
      name="infolabsa-results-with-state"
      for="*"
      class="senaite.impress.browser.results.infolabsa_results.InfolabsaResults"
      template="templates/results_with_state.pt"
      permission="zope2.View" />

  <!-- ========================================================= -->
  <!-- NUEVO: Mini-panel Delta Check (sin plantilla, retorna dict) -->
  <browser:page
      name="infolabsa-delta-check"
      for="*"
      class="senaite.impress.browser.results.delta_check.InfolabsaDeltaCheck"
      permission="zope2.View" />

</configure>
