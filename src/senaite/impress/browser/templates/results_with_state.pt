<tal:results i18n:domain="senaite.impress">
<div id="results-with-state">

<!-- ===== Estilos para resaltar signos/leyendas ===== -->
<style>
  /* Colores semánticos y accesibles (clínicos) */
  .flag-ok       { color:#198754 !important; font-weight:700; } /* ✓ en rango (verde) */
  .fr-alert      { color:#d9534f !important; font-weight:700; } /* ⚠ fuera de rango (rojo) */
  .al-critical   { color:#d63384 !important; font-weight:800; } /* ❗ crítico (magenta) */
  .al-delta      { color:#fd7e14 !important; font-weight:700; } /* ▲/▼ delta (naranja) */

  /* Por si el backend usa clases de estado clínico (las conservamos) */
  .estado-ok     { color:#198754; font-weight:700; }
  .estado-warn   { color:#d9534f; font-weight:700; }
  .estado-crit   { color:#d63384; font-weight:800; }
  .estado-na     { color:#6c757d; }

  /* ====== Chip de ESTADO (workflow) profesional ====== */
  .state-chip {
    display: inline-flex;
    gap: .35em;
    align-items: center;
    padding: .15rem .4rem;
    border-radius: .375rem;
    line-height: 1.1;
    font-weight: 600;
    font-size: 0.95em;
    border: 1px solid transparent;
    white-space: nowrap;
  }
  /* Paleta para workflow (mapear desde texto) */
  .wf-ok {
    color: #155724;
    background: #d4edda;
    border-color: #c3e6cb;
  }
  .wf-pending {
    color: #856404;
    background: #fff3cd;
    border-color: #ffeeba;
  }
  .wf-bad {
    color: #721c24;
    background: #f8d7da;
    border-color: #f5c6cb;
  }
  .wf-na {
    color: #495057;
    background: #e9ecef;
    border-color: #dee2e6;
  }

  /* Permite que los rangos largos hagan wrap */
  #results-with-state table.table tbody td { white-space: normal; word-break: break-word; }
</style>

<table class="table table-sm table-condensed">
  <thead>
    <tr>
      <th i18n:translate="">Análisis</th>
      <th i18n:translate="">Resultado</th>
      <th i18n:translate="">Unidad</th>
      <th i18n:translate="">Rango de referencia</th>
      <th i18n:translate="">Estado</th>
      <th i18n:translate="">Alertas</th>
    </tr>
  </thead>
  <tbody>
    <tal:loop repeat="a view/analyses">
      <tal:row define="r python:view.row(a)">
        <tr>
          <td tal:content="python:r['name']">Análisis</td>
          <td tal:content="python:r['result']">—</td>

          <!-- Unidad: marcamos la celda como .unit para excluirla del colorizer -->
          <td class="unit" tal:content="python:r.get('unit') or u''">—</td>

          <!-- ===== RANGO DE REFERENCIA (usa ResultsRange del Analysis como en ± Especificaciones) ===== -->
          <td>
            <tal:ref define="
              obj      python:(hasattr(a,'getObject') and a.getObject() or None);
              rr       python:(obj and hasattr(obj,'getResultsRange') and obj.getResultsRange() or None);

              rr_min0  python:r.get('ref_low');
              rr_max0  python:r.get('ref_high');
              rr_eq0   python:r.get('ref_eq');
              rr_txt0  python:(r.get('ref_range') or r.get('range') or u'');

              rr_min_r python:(rr and (rr.get('min') or rr.get('low') or rr.get('min_value')) or None);
              rr_max_r python:(rr and (rr.get('max') or rr.get('high') or rr.get('max_value')) or None);
              rr_eq_r  python:(rr and (rr.get('target') or rr.get('result') or rr.get('eq')) or None);
              rr_src_r python:(rr and (rr.get('keyword') or rr.get('Keyword') or rr.get('service_keyword') or u'') or u'');

              rr_min   python:( rr_min0 if rr_min0 not in (None,u'', '') else rr_min_r );
              rr_max   python:( rr_max0 if rr_max0 not in (None,u'', '') else rr_max_r );
              rr_eq    python:( rr_eq0  if rr_eq0  not in (None,u'', '') else rr_eq_r  );
              rr_src   python:( r.get('ref_src') or rr_src_r or u'' );

              rr_text  python:(
                (rr_txt0 and unicode(rr_txt0)) or
                ((rr_eq  not in (None,u'', '')) and (u'='+unicode(rr_eq))) or
                ((rr_min not in (None,u'', '')) and (rr_max not in (None,u'', '')) and (unicode(rr_min)+u'–'+unicode(rr_max))) or
                ((rr_min not in (None,u'', '')) and (u'≥'+unicode(rr_min))) or
                ((rr_max not in (None,u'', '')) and (u'≤'+unicode(rr_max))) or
                u'—'
              )
            ">
              <span class="ref-range"
                    tal:attributes="
                      data-low  python: rr_min if rr_min not in (None,u'','') else '';
                      data-high python: rr_max if rr_max not in (None,u'','') else '';
                      data-src  python: rr_src;
                      title     python: rr_text">
                <span tal:content="python:rr_text">—</span>
              </span>
              <small class="text-muted ms-1" tal:condition="python:rr_src">
                <span tal:content="python:rr_src">src</span>
              </small>
            </tal:ref>
          </td>
          <!-- ===== FIN RANGO ===== -->

          <!-- ===== ESTADO (Workflow profesional) ===== -->
          <td class="text-center">
            <tal:wf define="
              wf_txt  python: (r.get('state') or r.get('status') or u'—');
              norm    python: wf_txt and unicode(wf_txt).strip().lower() or u'';
              wf_cls  python: (
                (norm in (u'published', u'verified', u'valid', u'verificado', u'publicado', u'aprobado')) and 'wf-ok' or
                (norm in (u'pending', u'to be verified', u'draft', u'pendiente', u'en progreso', u'por verificar')) and 'wf-pending' or
                (norm in (u'invalid', u'rejected', u'cancelled', u'retracted', u'inválido', u'rechazado', u'cancelado', u'retraído')) and 'wf-bad' or
                'wf-na'
              );
              wf_icon python: (
                (wf_cls=='wf-ok') and u'✓' or
                (wf_cls=='wf-pending') and u'…' or
                (wf_cls=='wf-bad') and u'✖' or
                u'•'
              )
            ">
              <span tal:attributes="class python:u'state-chip ' + wf_cls" title="Estado del análisis (workflow)">
                <span tal:content="python:wf_icon">•</span>
                <span tal:content="python:wf_txt or u'—'">—</span>
              </span>
            </tal:wf>
          </td>
          <!-- ===== FIN ESTADO ===== -->

          <!-- ===== ALERTAS ===== -->
          <td class="text-center">
            <tal:al define="
              _tofloat python:lambda v: ((isinstance(v,(int,float)) and float(v)) or ((v not in (None,u'', '')) and float(unicode(v).replace(',','.'))) or None);
              res_val python:_tofloat(r.get('result'));
              min_v   python:(r.get('ref_low')  if r.get('ref_low')  not in (None,u'','') else None);
              max_v   python:(r.get('ref_high') if r.get('ref_high') not in (None,u'','') else None);
              has_rng python:((min_v not in (None,)) or (max_v not in (None,)));
              out_low python:((res_val is not None) and (min_v is not None) and (res_val < _tofloat(min_v)));
              out_hi  python:((res_val is not None) and (max_v is not None) and (res_val > _tofloat(max_v)));
              out_rng python:(out_low or out_hi);
              base_txt   python:(r.get('alert_text') or u'');
              base_title python:(r.get('alert_title') or u'');
              base_cls   python:(r.get('alert_classes') or u'');
              txt  python:(base_txt or (out_rng and u'Fuera de rango') or (has_rng and u'—') or u'—');
              ttl  python:(base_title or (out_low and u'Resultado por debajo del mínimo') or (out_hi and u'Resultado por encima del máximo') or u'');
              cls  python:(base_cls or (out_rng and u'fr-alert') or u'')
            ">
              <span tal:attributes="class python:cls; title python:ttl"
                    tal:content="python:txt">—</span>
            </tal:al>
          </td>
          <!-- ===== FIN ALERTAS ===== -->
        </tr>
      </tal:row>
    </tal:loop>
  </tbody>
</table>

<!-- Leyendas (clínicas) -->
<div class="mt-1 text-muted" style="font-size: 90%;">
  <span class="flag-ok" i18n:translate="">✓ En rango</span> ·
  <span class="fr-alert" i18n:translate="">⚠ Fuera de rango</span> ·
  <span class="al-critical" i18n:translate="">❗ Crítico</span> ·
  <span class="al-delta" i18n:translate="">▲/▼ Δ fuera de límite</span> ·
  <span i18n:translate="">— No aplica</span>
</div>

<!-- (Opcional) Leyenda breve de workflow -->
<div class="mt-1 text-muted" style="font-size: 90%; margin-top:4px;">
  <span class="state-chip wf-ok">✓ Publicado/Verificado</span>
  <span class="state-chip wf-pending">… Pendiente</span>
  <span class="state-chip wf-bad">✖ Rechazado/Inválido</span>
  <span class="state-chip wf-na">• N/A</span>
</div>

<!-- Guía para pacientes (técnica y clara) -->
<div class="mt-1 text-muted" style="font-size: 90%; margin-top:6px;">
  <div><strong>Guía de interpretación</strong></div>
  <div><span class="flag-ok">✓</span> <strong>En rango</strong>: Resultado dentro del intervalo de referencia para su edad/sexo.</div>
  <div><span class="fr-alert">⚠</span> <strong>Fuera de rango</strong>: Resultado fuera del intervalo de referencia. Puede requerir correlación clínica.</div>
  <div><span class="al-critical">❗</span> <strong>Crítico</strong>: Valor que cumple criterios de alerta crítica del laboratorio. <em>Puede requerir atención médica inmediata.</em></div>
  <div><span class="al-delta">▲/▼</span> <strong>Δ fuera de límite</strong>: Cambio relevante respecto al análisis previo del mismo tipo (se muestra porcentaje y fecha, si aplica).</div>
  <div>— <strong>No aplica</strong>: Análisis sin intervalo de referencia o de naturaleza cualitativa.</div>
</div>

<!-- Refuerzo: colorea símbolos SOLO dentro de este bloque (excluye .unit) -->
<script type="text/javascript">
(function(){
  var root = document.getElementById('results-with-state');
  if (!root) return;

  var colorize = function(container){
    // Pintar símbolos clínicos (✓/⚠/❗) donde corresponda
    var est = container.querySelectorAll('td.text-center span');
    for (var i=0;i<est.length;i++){
      var t = (est[i].textContent || '').trim();
      if (t.indexOf('✓') !== -1) est[i].classList.add('flag-ok');
      if (t.indexOf('❗') !== -1) est[i].classList.add('al-critical');
      if (t.indexOf('⚠') !== -1) est[i].classList.add('fr-alert');
    }

    // Excluir la columna de unidades (.unit)
    var cells = container.querySelectorAll('table tbody td:not(.unit), table tbody td.text-center span');

    // Coincidencias "sueltas" para H/HH/L/LL (evita mg/L, mmol/L, etc.)
    var reHigh = /(^|\s)(HH|H|↑)(?=\s|$)/g;
    var reLow  = /(^|\s)(LL|L|↓)(?=\s|$)/g;

    var wrap = function(html, re, cls){
      return html.replace(re, function(_, pre, flag){
        return pre + '<span class="'+cls+'">'+flag+'</span>';
      });
    };

    for (var j=0;j<cells.length;j++){
      var el = cells[j];
      var html = el.innerHTML;
      if (!html) continue;
      if (html.indexOf('<!--') !== -1) continue;

      var n = html;
      n = wrap(n, reHigh, 'fr-alert');
      n = wrap(n, reLow,  'al-delta');
      n = n.replace(/(⚠|❗)/g, '<span class="al-critical">$1</span>');
      n = n.replace(/(▲|▼|Δ)/g, '<span class="al-delta">$1</span>');

      if (n !== html) el.innerHTML = n;
    }
  };

  if (document.readyState === 'loading'){
    document.addEventListener('DOMContentLoaded', function(){ colorize(root); });
  } else {
    colorize(root);
  }
})();
</script>

</div>
</tal:results>
