<tal:report i18n:domain="senaite.impress">
  <!-- Assets estandar de Impress -->
  <tal:t replace="structure python:view.render_controls(context, **options)" />
  <tal:t replace="structure python:view.render_js(context, **options)" />
  <tal:t replace="structure python:view.render_css(context, **options)" />

  <!-- Afinado visual: separadores tenues estilo cool -->
  <style>
    .section-summary table.table-condensed {
      border-collapse: collapse;
      border-spacing: 0;
    }
    .section-summary table.table-condensed td {
      border-bottom: 1px solid #dee2e6 !important;
      padding-top: 2px;
      padding-bottom: 2px;
      vertical-align: top;
    }
    .section-summary h2 { margin-bottom: 6px !important; }
    .section-summary td.label { color: #666; font-weight: 700; width: 25%; }
    .section-summary td + td { width: 25%; }

    /* Titulares en negro y negritas */
    .section-title { color: #000; font-weight: 800; }

    /* Encabezado tipo default: tabla sin bordes/padding */
    .noborder { border: 0; }
    .noborder td, .noborder th { border: 0 !important; padding: 0 !important; }

    /* Contenedor de barcode como en default */
    .barcode { display: inline-block; line-height: 1; }
    .barcode canvas, .barcode svg, .barcode img {
      display: block;
      height: auto;
    }

    /* ===== Pegado total a la derecha del código de barras ===== */
    .barcode-box{
      display:inline-block;
      text-align:right;    /* mantiene el bloque a la derecha */
      float:right;         /* ancla al borde derecho del <td> */
      margin-right:0;
    }
    .section-summary .noborder td.text-right { padding-right: 0 !important; }

    /* === SOLO CAMBIO: HRI centrado bajo el código de barras === */
    .barcode-hri {
      display: block;
      text-align: center;  /* centra el ID */
      font-size: 11px;
      font-weight: 800;
      color: #000;
      margin-top: 2px;
      line-height: 1.1;
      /* quitamos width:max-content y margin-left:auto para permitir centrado */
    }

    /* === Alineación por defecto a la IZQUIERDA (como en Datos del Paciente) === */
    .section-summary table.table-condensed td,
    .section-summary table.table-condensed th {
      text-align: left; /* fuerza izquierda por defecto */
      padding-left: .5rem;
      padding-right: .5rem;
    }

    /* Celda con el ID textual (tabla de datos) a la izquierda */
    .barcode-cell { text-align: left; }

    /* Resetea márgenes/sangrías del bloque y sus tablas */
    .section-summary .w-100 { margin-left: 0 !important; margin-right: 0 !important; }
    .section-summary .w-100 > table { margin-left: 0 !important; margin-right: 0 !important; width: 100% !important; }
    .section-summary .w-100 > table.noborder {
      border-collapse: collapse !important;
      table-layout: fixed;
    }
    .section-summary .w-100 > table.table { margin-top: 0 !important; }

    /* Mantén la celda del encabezado (barcode) con el contenedor visible */
    td.text-right #sample-barcode { display: block; }

    /* ====== CONTENIDOS centrados (ya lo tenías) ====== */
    .results-center-cells table.table tbody td:nth-child(n+2):nth-child(-n+6) {
      text-align: center !important;
      vertical-align: middle;
    }

    /* ====== ENCABEZADOS centrados en las mismas 5 columnas ====== */
    .results-center-cells table.table thead th:nth-child(n+2):nth-child(-n+6) {
      text-align: center !important;
    }
  </style>

  <!-- AR robusto (model.instance -> view.context -> context) -->
  <div tal:define="
         get python:getattr;
         model python:get(view, 'model', None);
         ar python:(get(model, 'instance', None) or get(view, 'context', None) or context)">

    <!-- Encabezado -->
    <div class="row section-header no-gutters">
      <div class="w-100 mb-2">
        <table class="w-100 mb-0 noborder">
          <colgroup><col style=&quot;width:65%&quot;/><col style=&quot;width:35%&quot;/></colgroup>
          <tr>
            <td class="align-middle text-left">
              <h1 class="font-size-175" i18n:translate="">Informe de Resultados</h1>
              <div class="font-weight-bold font-size-120">INFOLABSA</div>
            </td>
            <td class="align-middle text-right">
              <img class="logo" tal:attributes="src string:${context/portal_url}/@@site-logo" />
            </td>
          </tr>
        </table>
      </div>
    </div>

    <!-- Secciones estandar (conservadas) -->
    <tal:t replace="structure python:view.render_info(ar, **options)" />
    <tal:t replace="structure python:view.render_alerts(ar, **options)" />

    <!-- Datos del Paciente -->
    <tal:patient define="
      get python:getattr;
      patient python:(
        (get(ar,'getPatient',None) and ar.getPatient()) or
        (get(ar,'Patient',None) and ar.Patient()) or
        (get(ar,'getRelatedPatient',None) and ar.getRelatedPatient()) or
        None
      );
      mrn_raw python:(
        (get(ar,'getMedicalRecordNumber',None) and ar.getMedicalRecordNumber()) or
        (get(ar,'getClientPatientID',None) and ar.getClientPatientID()) or
        (get(ar,'getPatientID',None) and ar.getPatientID()) or
        (get(ar,'getMRN',None) and ar.getMRN()) or
        (patient and get(patient,'getMedicalRecordNumber',None) and patient.getMedicalRecordNumber()) or
        (patient and get(patient,'getClientPatientID',None) and patient.getClientPatientID()) or
        (patient and get(patient,'getPatientID',None) and patient.getPatientID()) or
        (patient and get(patient,'getMRN',None) and patient.getMRN()) or
        (patient and get(patient,'getIdentifier',None) and patient.getIdentifier()) or
        (patient and get(patient,'getId',None) and patient.getId()) or
        (patient and get(patient,'id',None)) or
        options.get('mrn','') or
        options.get('expediente','') or
        options.get('nro_expediente','')
      );
      mrn python:(mrn_raw or u'');
      p_first python:(patient and get(patient,'getFirstname',None) and patient.getFirstname() or '');
      p_last  python:(patient and get(patient,'getSurname',None) and patient.getSurname() or (patient and get(patient,'getLastname',None) and patient.getLastname()) or '');
      fullname_comp python:((p_last and p_first) and u'%s, %s' % (p_last, p_first) or (p_first or p_last));
      patient_name python:(
        (get(ar,'getPatientFullName',None) and ar.getPatientFullName()) or
        (patient and get(patient,'getFullname',None) and patient.getFullname()) or
        (patient and get(patient,'Title',None) and patient.Title()) or
        fullname_comp or
        options.get('patient_fullname','')
      );
      dob_raw python:(
        (get(ar,'getDateOfBirth',None) and ar.getDateOfBirth()) or
        (get(ar,'getBirthDate',None) and ar.getBirthDate()) or
        (patient and get(patient,'getDateOfBirth',None) and patient.getDateOfBirth()) or
        (patient and get(patient,'getBirthDate',None) and patient.getBirthDate())
      );
      dob_dt python:(dob_raw and (dob_raw if hasattr(dob_raw,'year') else (dob_raw[0] if isinstance(dob_raw,tuple) else None)));
      dob_text python:(dob_dt and (hasattr(dob_dt,'strftime') and dob_dt.strftime('%d/%m/%Y') or view.to_localized_time(dob_dt)) or '');
      age_raw python:(
        (get(ar,'getAge',None) and ar.getAge()) or
        (patient and get(patient,'getAge',None) and patient.getAge()) or
        None
      );
      age_from_dob python:(dob_dt and get(view,'age_from_dob',None) and view.age_from_dob(dob_dt) or None);
      age_years_int python:(
        (hasattr(age_raw,'years') and int(age_raw.years)) or
        (isinstance(age_raw,int) and age_raw) or
        (isinstance(age_from_dob,int) and age_from_dob) or
        None
      );
      age_months_int python:(hasattr(age_raw,'months') and int(age_raw.months) or None);
      gender_raw python:(
        (get(ar,'getGender',None) and ar.getGender()) or
        (get(ar,'getSex',None) and ar.getSex()) or
        (patient and get(patient,'getGender',None) and patient.getGender()) or
        (patient and get(patient,'getSex',None) and patient.getSex()) or
        (patient and get(patient,'getGenderTitle',None) and patient.getGenderTitle()) or
        ''
      );
      gender_norm python:(
        (gender_raw in ('m','M','male','Male')) and u'Masculino' or
        (gender_raw in ('f','F','female','Female')) and u'Femenino' or
        gender_raw
      );
      show_patient python:any([mrn, patient_name, dob_dt, age_raw, age_from_dob, gender_norm]);
    ">
      <div class="row section-summary no-gutters" tal:condition="show_patient">
        <div class="w-100">
          <h2 class="mb-1 section-title" i18n:translate="">Datos del Paciente</h2>
          <table class="table table-sm table-condensed">
            <colgroup>
              <col style="width: 25%"/><col style="width: 25%"/>
              <col style="width: 25%"/><col style="width: 25%"/>
            </colgroup>
            <tr>
              <td class="label">Nro. Expediente</td>
              <td><span tal:content="mrn|nothing">-</span></td>
              <td class="label" i18n:translate="">Nombre completo</td>
              <td><span tal:content="patient_name|nothing">-</span></td>
            </tr>
            <tr>
              <td class="label" i18n:translate="">Fecha de nacimiento</td>
              <td>
                <span tal:condition="dob_text" tal:content="dob_text">-</span>
                <span tal:condition="not:dob_text">-</span>
              </td>
              <td class="label" i18n:translate="">Edad</td>
              <td>
                <span tal:condition="python:(age_years_int not in (None,0))"
                      tal:content="python:u'%s años' % age_years_int">-</span>
                <span tal:condition="python:((age_years_int in (None,0)) and (age_months_int not in (None,0)))"
                      tal:content="python:u'%s meses' % age_months_int">-</span>
                <span tal:condition="python:((age_years_int in (None,0)) and (age_months_int in (None,0)))"
                      tal:content="age_raw|nothing">-</span>
              </td>
            </tr>
            <tr>
              <td class="label" i18n:translate="">Género</td>
              <td><span tal:content="gender_norm|nothing">-</span></td>
              <td class="label"></td>
              <td></td>
            </tr>
          </table>
        </div>
      </div>
    </tal:patient>

    <!-- Resumen de la Muestra -->
    <tal:sample define="
      get python:getattr;
      sid python:(
        (get(ar,'getId',None) and ar.getId()) or
        (hasattr(ar,'id') and ar.id) or
        (get(ar,'getRequestID',None) and ar.getRequestID()) or
        u''
      );
      stype python:(
        (get(ar,'getSampleTypeTitle',None) and ar.getSampleTypeTitle()) or
        (get(ar,'getSampleType',None) and ar.getSampleType() and ar.getSampleType().Title()) or
        u''
      );
      rec_dt python:(
        (get(ar,'getDateReceived',None) and ar.getDateReceived()) or
        (get(ar,'getReceptionDate',None) and ar.getReceptionDate()) or
        None
      );
      pub_dt python:(
        (get(ar,'getDatePublished',None) and ar.getDatePublished()) or
        (get(ar,'getPublicationDate',None) and ar.getPublicationDate()) or
        None
      );
      rec_txt python:(rec_dt and view.to_localized_time(rec_dt) or u'');
      pub_txt python:(pub_dt and view.to_localized_time(pub_dt) or u'');
      show_sample python:any([sid, stype, rec_dt, pub_dt]);
    ">
      <div class="row section-summary no-gutters" tal:condition="show_sample">
        <div class="w-100">

          <!-- Encabezado tipo default: título izq / barcode + HRI der -->
          <table class="w-100 mb-1 noborder">
            <colgroup><col style="width:70%"/><col style="width:30%"/></colgroup>
            <tr>
              <td class="align-middle">
                <h2 class="mb-1 section-title">Resumen de la Muestra</h2>
              </td>
              <td class="align-middle text-right" tal:condition="sid">
                <!-- Wrapper para pegar el barcode al borde derecho -->
                <div class="barcode-box">
                  <div id="sample-barcode" class="barcode"
                       tal:attributes="
                         data-code sid;
                         data-type string:code128;
                         data-barwidth string:1;
                         data-barheight string:26;
                         title sid">
                    <!-- Fallback textual (lo limpia el init si corre) -->
                    <span tal:replace="sid">SAMPLE-ID</span>
                  </div>
                  <div class="barcode-hri"><span tal:replace="sid">SAMPLE-ID</span></div>
                </div>

                <script type="text/javascript">
                  (function() {
                    if (window.jQuery) {
                      var $ = window.jQuery;
                      $(function(){
                        var $el = $('#sample-barcode');
                        if ($el.length && typeof $el.barcode === 'function') {
                          var code = $el.attr('data-code') || $el.data('code') || $.trim($el.text());
                          if (code && !$el.find('canvas, svg, img').length) {
                            try {
                              $el.empty().barcode(
                                code,
                                $el.attr('data-type') || 'code128',
                                {
                                  /* === MEDIDA DEFAULT === */
                                  barWidth: parseInt($el.attr('data-barwidth') || 1, 10),
                                  barHeight: parseInt($el.attr('data-barheight') || 26, 10),
                                  /* Alta legibilidad impresa */
                                  bgColor: '#ffffff',
                                  color: '#000000',
                                  /* Si el plugin soporta SVG, deja mejor rasterizado al imprimir */
                                  output: 'svg',
                                  /* Usamos HRI manual (debajo) */
                                  showHRI: false
                                }
                              );
                            } catch(e) { /* no-op */ }
                          }
                        }
                      });
                    }
                  })();
                </script>
              </td>
            </tr>
          </table>

          <table class="table table-sm table-condensed">
            <colgroup>
              <col style="width: 25%"/><col style="width: 25%"/>
              <col style="width: 25%"/><col style="width: 25%"/>
            </colgroup>
            <tr>
              <td class="label">ID de muestra</td>
              <td class="barcode-cell"><span tal:content="sid|nothing">-</span></td>
              <td class="label">Tipo</td>
              <td><span tal:content="stype|nothing">-</span></td>
            </tr>
            <tr>
              <td class="label">Recepción</td>
              <td><span tal:content="rec_txt|nothing">-</span></td>
              <td class="label">Publicación</td>
              <td><span tal:content="pub_txt|nothing">-</span></td>
            </tr>
          </table>
        </div>
      </div>
    </tal:sample>

    <!-- Resumen de la Muestra (estándar) —> COMENTADO, no eliminado -->
    <!--
    <tal:t replace="structure python:view.render_summary(ar, **options)" />
    -->

    <!-- Resultados con Estado + Alertas -->
    <h2 class="mb-1 section-title">Resultados</h2>
    <div class="results-center-cells">
      <tal:t replace="structure python:ar.restrictedTraverse('@@infolabsa-results-with-state')()" />
    </div>

    <!-- Interpretación de resultados (solo si hay contenido real) -->
    <tal:interp define="
      get python:getattr;
      re  python:modules['re'];

      sid python:(
        (get(ar,'getId',None) and ar.getId()) or
        (hasattr(ar,'id') and ar.id) or
        (get(ar,'getRequestID',None) and ar.getRequestID()) or
        u''
      );

      gen_raw python:(
        (get(ar,'getResultsInterpretation',None) and ar.getResultsInterpretation()) or
        (get(ar,'getInterpretation',None) and ar.getInterpretation()) or
        (get(ar,'getInterpretationGeneral',None) and ar.getInterpretationGeneral())
      );
      qc_raw  python:(
        (get(ar,'getInterpretationChemistry',None) and ar.getInterpretationChemistry()) or
        (get(ar,'getChemistryInterpretation',None) and ar.getChemistryInterpretation())
      );

      to_text   python:(lambda s: (s and re.sub(u'<[^>]+>', u'', unicode(s))) or u'');
      has_text  python:(lambda s: bool(to_text(s).strip()));

      gen_has python:has_text(gen_raw);
      qc_has  python:has_text(qc_raw);
      show    python:any([gen_has, qc_has]);
    ">
      <div class="row section-interp no-gutters" tal:condition="show">
        <div class="w-100">
          <h2 class="mb-1 section-title">
            <span i18n:translate="">Interpretación de resultados para </span><span tal:replace="sid">AR-ID</span>
          </h2>

          <tal:gen tal:condition="gen_has">
            <h3 class="mb-0" i18n:translate="">General</h3>
            <div tal:content="structure gen_raw">-</div>
          </tal:gen>

          <tal:qc tal:condition="qc_has">
            <h3 class="mb-0" i18n:translate="">Análisis Clínicos o Químicos</h3>
            <div tal:content="structure qc_raw">-</div>
          </tal:qc>
        </div>
      </div>
    </tal:interp>

    <!-- Adjuntos, observaciones, firmas -->
    <tal:t replace="structure python:view.render_attachments(ar, **options)" />
    <tal:t replace="structure python:view.render_remarks(ar, **options)" />

    <!-- Firmas -->
    <tal:t replace="structure python:view.render_signatures(ar, **options)" />

    <!-- Discreeter y pie -->
    <tal:t replace="structure python:view.render_discreeter(ar, **options)" />
    <tal:t replace="structure python:view.render_footer(ar, **options)" />
  </div>
</tal:report>
