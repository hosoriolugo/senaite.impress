<?xml version="1.0" encoding="utf-8"?>
<tal:report i18n:domain="senaite.impress">
  <!-- INFOLABSA.pt :: FINAL -->

  <!-- Assets estándar de Impress -->
  <tal:t replace="structure python:view.render_controls(context, **options)" />
  <tal:t replace="structure python:view.render_js(context, **options)" />
  <tal:t replace="structure python:view.render_css(context, **options)" />

  <!-- Highcharts (solo navegador) -->
  <script src="++plone++senaite.impress.static/modules/highcharts/highcharts.js"></script>

  <!-- Afinado visual + control de paginado -->
  <style>
    .section-summary table.table-condensed { border-collapse: collapse; border-spacing: 0; }
    .section-summary table.table-condensed td { border-bottom: 1px solid #dee2e6 !important; padding-top: 2px; padding-bottom: 2px; vertical-align: top; }
    .section-summary h2 { margin-bottom: 6px !important; }
    .section-summary td.label { color: #666; font-weight: 700; width: 25%; }
    .section-summary td + td { width: 25%; }

    .section-title { color: #000; font-weight: 800; }

    .noborder { border: 0; }
    .noborder td, .noborder th { border: 0 !important; padding: 0 !important; }

    .barcode { display: inline-block; line-height: 1; }
    .barcode canvas, .barcode svg, .barcode img { display: block; height: auto; }

    .barcode-box{ display:inline-block; text-align:right; float:right; margin-right:0; }
    .section-summary .noborder td.text-right { padding-right: 0 !important; }

    .barcode-hri { display: block; text-align: center; font-size: 11px; font-weight: 800; color: #000; margin-top: 2px; line-height: 1.1; }

    .section-summary table.table-condensed td,
    .section-summary table.table-condensed th { text-align: left; padding-left: .5rem; padding-right: .5rem; }

    .barcode-cell { text-align: left; }

    .section-summary .w-100 { margin-left: 0 !important; margin-right: 0 !important; }
    .section-summary .w-100 > table { margin-left: 0 !important; margin-right: 0 !important; width: 100% !important; }
    .section-summary .w-100 > table.noborder { border-collapse: collapse !important; table-layout: fixed; }
    .section-summary .w-100 > table.table { margin-top: 0 !important; }

    td.text-right #sample-barcode { display: block; }

    .results-center-cells table.table tbody td:nth-child(n+2):nth-child(-n+6) { text-align: center !important; vertical-align: middle; }
    .results-center-cells table.table thead th:nth-child(n+2):nth-child(-n+6) { text-align: center !important; }
    .results-center-cells table.table.table-condensed { border-collapse: collapse; border-spacing: 0; }
    .results-center-cells table.table.table-condensed thead th { border-bottom: 0 !important; padding-top: 2px; padding-bottom: 2px; vertical-align: bottom; }
    .results-center-cells table.table.table-condensed thead tr { border-bottom: 1px solid #dee2e6 !important; }
    .results-center-cells table.table.table-condensed tbody td { border-bottom: 1px solid #dee2e6 !important; padding-top: 2px; padding-bottom: 2px; vertical-align: middle; }

    .section-interp h3 { color: #000; font-weight: 800; }

    /* === Panel Delta Check === */
    .section-delta h2 { color:#000; font-weight:800; margin-bottom:6px !important; }
    .section-delta .small { font-size:90%; color:#6c757d; }
    .section-delta table.table-sm td, .section-delta table.table-sm th { padding-top:2px; padding-bottom:2px; }
    .section-delta .delta-up   { color:#fd7e14; font-weight:700; }
    .section-delta .delta-down { color:#0d6efd; font-weight:700; }
    .section-delta .spark { width:120px; height:36px; }
    .section-delta .rcv-ok  { color:#198754; font-weight:700; }
    .section-delta .rcv-bad { color:#dc3545; font-weight:700; }
    .section-delta table.table-condensed thead th:nth-child(2),
    .section-delta table.table-condensed thead th:nth-child(3),
    .section-delta table.table-condensed thead th:nth-child(4),
    .section-delta table.table-condensed thead th:nth-child(5) { text-align: center; }
    .section-delta table.table-condensed tbody td:nth-child(2),
    .section-delta table.table-condensed tbody td:nth-child(3),
    .section-delta table.table-condensed tbody td:nth-child(4),
    .section-delta table.table-condensed tbody td:nth-child(5) { text-align: center; vertical-align: middle; }
    .section-delta table.table-condensed thead th:nth-child(6),
    .section-delta table.table-condensed tbody td:nth-child(6) { text-align: center; vertical-align: middle; }
    .section-delta .trend-range { font-size: 10px; color:#6c757d; line-height:1.1; margin-top:2px; white-space:nowrap; text-align:center; }
    .section-delta .trend-arrow { display: block; font-size: 16px; font-weight: 700; line-height: 1; margin-bottom: 2px; text-align: center; }
    .section-delta .trend-up   { color:#fd7e14; }
    .section-delta .trend-down { color:#0d6efd; }
    .section-delta .trend-flat { color:#6c757d; }

    /* ===== SECCIÓN TENDENCIAS ===== */
    .section-trends { margin: 30px 0; page-break-inside: avoid; clear: both; text-align: initial !important; direction: ltr !important; }
    .section-trends .section-title { color: #000; font-weight: 800; margin-bottom: 15px !important; border-bottom: 2px solid #2c3e50; padding-bottom: 5px; }
    .section-trends .chart-center-wrap { width: 180mm; max-width: 100%; margin: 0 auto !important; float: none !important; display: flex; justify-content: center; align-items: flex-start; }
    .section-trends .chart-container { width: 100% !important; height: 560px; margin: 20px 0; border: 1px solid #e9ecef; border-radius: 4px; padding: 0; background: #fff; overflow: visible; display: none; float: none !important; }
    .section-trends .chart-container .highcharts-title,
    .section-trends .chart-container .highcharts-subtitle { display: block !important; opacity: 1 !important; visibility: visible !important; }
    .section-trends .chart-container svg { overflow: visible !important; }
    .section-trends .fallback-message { text-align: center; padding: 20px; background: #f8f9fa; border-radius: 5px; border: 1px dashed #dee2e6; }
    .section-trends .fallback-message img { display: block; max-width: 100%; height: auto; margin: 0 auto; }

    /* Visibilidad navegador/PDF */
    .no-weasyprint { display: none !important; }
    .weasy-fallback { display: block !important; }
    body.has-highcharts .weasy-fallback { display: none !important; }

    /* Paginación */
    .section-interp { page-break-before: always; }
    .section-trends { page-break-inside: avoid; }
    .section-delta { page-break-before: auto; break-before: auto; margin-top: 8mm; }

    /* Cola del informe */
    .tail-pack { break-inside: avoid; page-break-inside: avoid; margin-bottom: 8mm; }
    .tail-pack .section-signatures, .tail-pack .section-remarks { break-inside: avoid; page-break-inside: avoid; }

    /* Anexos finales */
    .attachments-end { page-break-before: auto; margin-top: 8mm; }
    .attachments-end .tail-title { font-weight: 800; color: #000; margin: 8px 0 6px; }
    .section-attachments h1:first-of-type, .section-attachments h2:first-of-type, .section-attachments h3:first-of-type { display: none !important; }
    .section-attachments img { max-width: 180mm; width: 100%; height: auto; }

    @media print {
      .tail-pack { display:inline-block; width:100%; page-break-inside: avoid; break-inside: avoid; }
      .tail-pack .section-signatures, .tail-pack .section-remarks { page-break-inside: avoid; break-inside: avoid; }
      .pagebreak { page-break-before: always; }
      .pagebreak-before { page-break-before: always; }
      .avoid-break-inside { page-break-inside: avoid; }
      .section-interp, .section-signatures { break-inside: avoid; }
      .section-delta { page-break-before: auto; margin-top: 8mm; }
      .no-weasyprint { display: none !important; }
      .weasy-fallback { display: block !important; }
      .section-trends { page-break-inside: avoid; break-inside: avoid; }
      .section-trends .weasy-fallback, .section-trends .weasy-fallback .fallback-message, .section-trends .weasy-fallback .section-title { page-break-inside: avoid; break-inside: avoid; }
      .section-trends .weasy-fallback .section-title { page-break-after: avoid; break-after: avoid; margin-bottom: 8px !important; }
      .section-trends .weasy-fallback .fallback-message img { display: block; page-break-inside: avoid; break-inside: avoid; max-width: 180mm; height: auto; }
      .attachments-end { display:inline-block; width:100%; page-break-inside: avoid; break-inside: avoid; }
    }

    /* Centrado PNG en preview/PDF (WeasyPrint) */
    .section-trends { float: none !important; clear: both !important; }
    .section-trends .weasy-fallback { display: block !important; text-align: center !important; }
    .section-trends .weasy-fallback .fallback-message { display: block !important; max-width: 180mm; margin: 0 auto !important; float: none !important; padding: 0; border: 0; background: transparent; }
    .section-trends .weasy-fallback .fallback-message img { display: block !important; width: 100% !important; max-width: 180mm !important; height: auto !important; margin: 0 auto !important; }
  </style>

  <!-- AR robusto (model.instance -> view.context -> context) -->
  <div tal:define="
         get python:getattr;
         model python:get(view, 'model', None);
         ar python:(get(model, 'instance', None) or get(view, 'context', None) or context)">

    <!-- Encabezado -->
    <div class="row section-header no-gutters">
      <div class="w-100 mb-2">
        <table class="w-100 mb-0 noborder">
          <colgroup><col style=&quot;width:65%&quot;/><col style=&quot;width:35%&quot;/></colgroup>
          <tr>
            <td class="align-middle text-left">
              <h1 class="font-size-175" i18n:translate="">Informe de Resultados</h1>
            </td>
            <td class="align-middle text-right"></td>
          </tr>
        </table>
      </div>
    </div>

    <!-- Secciones estándar -->
    <tal:t replace="structure python:view.render_info(ar, **options)" />
    <tal:t replace="structure python:view.render_alerts(ar, **options)" />

    <!-- Datos del Paciente -->
    <tal:patient define="
      get python:getattr;

      patient python:(
        (get(ar,'getPatient',None) and ar.getPatient()) or
        (get(ar,'Patient',None) and ar.Patient()) or
        (get(ar,'getRelatedPatient',None) and ar.getRelatedPatient()) or
        None
      );

      idents python:(patient and (get(patient,'getIdentifiers',None) and patient.getIdentifiers()) or []) ;

      mrn_from_ids python:(
        u''.join([ i.get('value','') for i in (idents or [])
                   if (i.get('key','').strip().lower() in
                       ('mrn','medical record','medical record #','medical record number','expediente')) ]) or u''
      );

      mrn_raw python:(
        (get(ar,'getMedicalRecordNumberValue',None) and ar.getMedicalRecordNumberValue()) or
        (get(ar,'getMedicalRecordNumber',None) and ar.getMedicalRecordNumber()) or
        (get(ar,'getMRN',None) and ar.getMRN()) or
        (patient and get(patient,'getMRN',None) and patient.getMRN()) or
        (patient and hasattr(patient,'mrn') and patient.mrn) or
        (patient and get(patient,'getMedicalRecordNumber',None) and patient.getMedicalRecordNumber()) or
        mrn_from_ids or
        (get(ar,'getClientPatientID',None) and ar.getClientPatientID()) or
        (patient and get(patient,'getClientPatientID',None) and patient.getClientPatientID()) or
        (get(ar,'getPatientID',None) and ar.getPatientID()) or
        (patient and get(patient,'getPatientID',None) and patient.getPatientID()) or
        (patient and get(patient,'getIdentifier',None) and patient.getIdentifier()) or
        options.get('mrn','') or options.get('expediente','') or options.get('nro_expediente','')
      );

      mrn python:(
        (mrn_raw and
          ( (hasattr(mrn_raw,'decode') and (isinstance(mrn_raw, str) and mrn_raw.decode('utf-8','ignore') or mrn_raw)) or
            (hasattr(mrn_raw,'strip') and mrn_raw.strip()) or
            unicode(mrn_raw) )
        ) or u''
      );

      p_first python:(patient and get(patient,'getFirstname',None) and patient.getFirstname() or '');
      p_last  python:(patient and get(patient,'getSurname',None) and patient.getSurname() or (patient and get(patient,'getLastname',None) and patient.getLastname()) or '');
      fullname_comp python:((p_last and p_first) and u'%s, %s' % (p_last, p_first) or (p_first or p_last));
      patient_name python:(
        (get(ar,'getPatientFullName',None) and ar.getPatientFullName()) or
        (patient and get(patient,'getFullname',None) and patient.getFullname()) or
        (patient and get(patient,'Title',None) and patient.Title()) or
        fullname_comp or
        options.get('patient_fullname','')
      );

      dob_raw python:(
        (get(ar,'getDateOfBirth',None) and ar.getDateOfBirth()) or
        (get(ar,'getBirthDate',None) and ar.getBirthDate()) or
        (patient and get(patient,'getDateOfBirth',None) and patient.getDateOfBirth()) or
        (patient and get(patient,'getBirthDate',None) and patient.getBirthDate())
      );
      dob_dt python:(dob_raw and (dob_raw if hasattr(dob_raw,'year') else (dob_raw[0] if isinstance(dob_raw,tuple) else None)));
      dob_text python:(dob_dt and (hasattr(dob_dt,'strftime') and dob_dt.strftime('%d/%m/%Y') or view.to_localized_time(dob_dt)) or '');

      age_raw python:(
        (get(ar,'getAge',None) and ar.getAge()) or
        (patient and get(patient,'getAge',None) and patient.getAge()) or
        None
      );
      age_from_dob python:(dob_dt and get(view,'age_from_dob',None) and view.age_from_dob(dob_dt) or None);
      age_years_int python:(
        (hasattr(age_raw,'years') and int(age_raw.years)) or
        (isinstance(age_raw,int) and age_raw) or
        (isinstance(age_from_dob,int) and age_from_dob) or
        None
      );
      age_months_int python:(hasattr(age_raw,'months') and int(age_raw.months) or None);
      age_days_int python:(hasattr(age_raw,'days') and int(age_raw.days) or None);

      gender_raw python:(
        (get(ar,'getGender',None) and ar.getGender()) or
        (get(ar,'getSex',None) and ar.getSex()) or
        (patient and get(patient,'getGender',None) and patient.getGender()) or
        (patient and get(patient,'getSex',None) and patient.getSex()) or
        (patient and get(patient,'getGenderTitle',None) and patient.getGenderTitle()) or
        ''
      );
      gender_norm python:(
        (gender_raw in ('m','M','male','Male')) and u'Masculino' or
        (gender_raw in ('f','F','female','Female')) and u'Femenino' or
        gender_raw
      );

      show_patient python:any([mrn, patient_name, dob_dt, age_raw, age_from_dob, gender_norm]);
    ">
      <div class="row section-summary no-gutters" tal:condition="show_patient">
        <div class="w-100">
          <h2 class="mb-1 section-title" i18n:translate="">Datos del Paciente</h2>
          <table class="table table-sm table-condensed">
            <colgroup>
              <col style="width: 25%"/><col style="width: 25%"/>
              <col style="width: 25%"/><col style="width: 25%"/>
            </colgroup>
            <tr>
              <td class="label">Nro. Expediente</td>
              <td><span tal:content="mrn|nothing">-</span></td>
              <td class="label" i18n:translate="">Nombre completo</td>
              <td><span tal:content="patient_name|nothing">-</span></td>
            </tr>
            <tr>
              <td class="label" i18n:translate="">Fecha de nacimiento</td>
              <td>
                <span tal:condition="dob_text" tal:content="dob_text">-</span>
                <span tal:condition="not:dob_text">-</span>
              </td>
              <td class="label" i18n:translate="">Edad</td>
              <td>
                <span tal:condition="python:(age_years_int not in (None,0))"
                      tal:content="python:u'%s a\u00f1os' % age_years_int">-</span>
                <span tal:condition="python:((age_years_int in (None,0)) and (age_months_int not in (None,0)))"
                      tal:content="python:u'%s meses' % age_months_int">-</span>
                <span tal:condition="python:((age_years_int in (None,0)) and (age_months_int in (None,0)) and (age_days_int not in (None,0)))"
                      tal:content="python:u'%s d\u00edas' % age_days_int">-</span>
                <span tal:condition="python:((age_years_int in (None,0)) and (age_months_int in (None,0)) and (age_days_int in (None,0)))"
                      tal:content="age_raw|nothing">-</span>
              </td>
            </tr>
            <tr>
              <td class="label" i18n:translate="">Género</td>
              <td><span tal:content="gender_norm|nothing">-</span></td>
              <td class="label"></td>
              <td></td>
            </tr>
          </table>
        </div>
      </div>
    </tal:patient>

    <!-- Resumen de la Muestra -->
    <tal:sample define="
      get python:getattr;
      sid python:(
        (get(ar,'getId',None) and ar.getId()) or
        (hasattr(ar,'id') and ar.id) or
        (get(ar,'getRequestID',None) and ar.getRequestID()) or
        u''
      );
      stype python:(
        (get(ar,'getSampleTypeTitle',None) and ar.getSampleTypeTitle()) or
        (get(ar,'getSampleType',None) and ar.getSampleType() and ar.getSampleType().Title()) or
        u''
      );
      rec_dt python:(
        (get(ar,'getDateReceived',None) and ar.getDateReceived()) or
        (get(ar,'getReceptionDate',None) and ar.getReceptionDate()) or
        None
      );
      ver_dt python:(
        (get(view,'verification_datetime',None) and view.verification_datetime(ar)) or
        (get(ar,'getDateVerified',None) and ar.getDateVerified()) or
        None
      );
      rec_txt python:(rec_dt and view.to_localized_time(rec_dt) or u'');
      ver_txt python:(ver_dt and view.to_localized_time(ver_dt) or u'');
      show_sample python:any([sid, stype, rec_dt, ver_dt]);
    ">
      <div class="row section-summary no-gutters" tal:condition="show_sample">
        <div class="w-100">
          <table class="w-100 mb-1 noborder">
            <colgroup><col style="width:70%"/><col style="width:30%"/></colgroup>
            <tr>
              <td class="align-middle">
                <h2 class="mb-1 section-title">Resumen de la Muestra</h2>
              </td>
              <td class="align-middle text-right" tal:condition="sid">
                <div class="barcode-box">
                  <div id="sample-barcode" class="barcode"
                       tal:attributes="
                         data-code sid;
                         data-type string:code128;
                         data-barwidth string:1;
                         data-barheight string:26;
                         title sid">
                    <span tal:replace="sid">SAMPLE-ID</span>
                  </div>
                  <div class="barcode-hri"><span tal:replace="sid">SAMPLE-ID</span></div>
                </div>
                <script type="text/javascript">
                  (function() {
                    if (window.jQuery) {
                      var $ = window.jQuery;
                      $(function(){
                        var $el = $('#sample-barcode');
                        if ($el.length && typeof $el.barcode === 'function') {
                          var code = $el.attr('data-code') || $el.data('code') || $.trim($el.text());
                          if (code && !$el.find('canvas, svg, img').length) {
                            try {
                              $el.empty().barcode(
                                code,
                                $el.attr('data-type') || 'code128',
                                {
                                  barWidth: parseInt($el.attr('data-barwidth') || 1, 10),
                                  barHeight: parseInt($el.attr('data-barheight') || 26),
                                  bgColor: '#ffffff',
                                  color: '#000000',
                                  output: 'svg',
                                  showHRI: false
                                }
                              );
                            } catch(e) { /* no-op */ }
                          }
                        }
                      });
                    }
                  })();
                </script>
              </td>
            </tr>
          </table>

          <table class="table table-sm table-condensed">
            <colgroup>
              <col style="width: 25%"/><col style="width: 25%"/>
              <col style="width: 25%"/><col style="width: 25%"/>
            </colgroup>
            <tr>
              <td class="label">ID de muestra</td>
              <td class="barcode-cell"><span tal:content="sid|nothing">-</span></td>
              <td class="label">Tipo de muestra</td>
              <td><span tal:content="stype|nothing">-</span></td>
            </tr>
            <tr>
              <td class="label">Recepción</td>
              <td><span tal:content="rec_txt|nothing">-</span></td>
              <td class="label">Verificación</td>
              <td><span tal:content="ver_txt|nothing">-</span></td>
            </tr>
          </table>
        </div>
      </div>
    </tal:sample>

    <!-- Resultados con Estado + Alertas -->
    <h2 class="mb-1 section-title">Resultados</h2>
    <div class="results-center-cells">
      <tal:t replace="structure python:ar.restrictedTraverse('@@infolabsa-results-with-state')()" />
    </div>

    <!-- Traducción de estados (workflow) a español, sin imports de Python -->
    <script type="text/javascript">
      (function(){
        function translateStates(){
          var root = document.querySelector('.results-center-cells');
          if (!root) return;
          var map = {
            'to_be_verified': 'Pendiente de verificar',
            'to-be-verified': 'Pendiente de verificar',
            'pending': 'Pendiente de verificar',
            'verified': 'Verificada',
            'published': 'Publicada',
            'invalid': 'Inválida',
            'rejected': 'Rechazada',
            'retracted': 'Retractada',
            'awaiting': 'En espera',
            'not_performed': 'No realizado',
            'sample_received': 'Muestra recibida'
          };
          var keys = Object.keys(map);
          var walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT, null, false);
          var node;
          while ((node = walker.nextNode())) {
            var t = node.nodeValue;
            if (!t) continue;
            var tLower = t.toLowerCase();
            var changed = false;
            keys.forEach(function(k){
              var idx = tLower.indexOf(k);
              if (idx !== -1) {
                var before = t.slice(0, idx);
                var after  = t.slice(idx + k.length);
                t = before + map[k] + after;
                tLower = t.toLowerCase();
                changed = true;
              }
            });
            if (changed) node.nodeValue = t;
          }
        }
        if (document.readyState === 'loading'){
          document.addEventListener('DOMContentLoaded', translateStates);
        } else {
          translateStates();
        }
      })();
    </script>

    <!-- Interpretación de resultados -->
    <tal:interp define="

      get python:getattr;

      _rich python:lambda x: (
        (hasattr(x,'output') and x.output) or
        (hasattr(x,'raw') and x.raw) or
        (isinstance(x, dict) and (x.get('richtext') or x.get('output') or x.get('raw') or x.get('data') or x.get('text'))) or
        (isinstance(x, basestring) and x) or
        u''
      );

      _bydept0 python:(get(ar,'getResultsInterpretationByDepartment',None) and ar.getResultsInterpretationByDepartment or None);
      gen_dept_dict python:(_bydept0 and _bydept0(None) or {});
      gen_dept_html python:_rich(gen_dept_dict.get('richtext'));

      gen_raw python:(
        (get(ar,'getResultsInterpretation',None) and ar.getResultsInterpretation()) or
        (get(ar,'getInterpretationGeneral',None) and ar.getInterpretationGeneral()) or
        (get(ar,'getGeneralInterpretation',None) and ar.getGeneralInterpretation()) or
        (get(ar,'getInterpretation',None) and ar.getInterpretation()) or
        u''
      );
      gen_html_legacy python:_rich(gen_raw);
      gen_html python:(gen_dept_html or gen_html_legacy);
      gen python:((gen_html and (hasattr(gen_html,'strip') and gen_html.strip() or gen_html)) or u'');

      qc_raw  python:(
        (get(ar,'getInterpretationChemistry',None) and ar.getInterpretationChemistry()) or
        (get(ar,'getChemistryInterpretation',None) and ar.getChemistryInterpretation()) or
        u''
      );
      qc_html python:_rich(qc_raw);
      qc  python:((qc_html and (hasattr(qc_html,'strip') and qc_html.strip() or qc_html)) or u'');
      qc_shown python:bool(qc);

      depts python:(get(ar,'getDepartments',None) and ar.getDepartments() or []);
      _bydept python:(get(ar,'getResultsInterpretationByDepartment',None) and ar.getResultsInterpretationByDepartment or None);

      dept_items python:(
        [
          {
            'title': (get(d,'Title',None) and d.Title() or u''),
            'text': (_bydept and _rich((_bydept(d) or {}).get('richtext')) or u'')
          }
          for d in depts
          if _bydept and (_rich((_bydept(d) or {}).get('richtext')) or u'')
             and (not qc_shown or not (((get(d,'Title',None) and d.Title() or u'').strip().lower() in ('chemistry', u'qu\u00edmica', u'qu\u00edmica cl\u00ednica'))))
        ]
      );
      has_dept python:any([i.get('text') for i in dept_items]);

      show python:any([gen, qc, has_dept]);
    ">
      <div class="row section-interp no-gutters pagebreak-before" tal:condition="show">
        <div class="w-100">
          <h2 class="mb-1 section-title" i18n:translate="">Interpretación de resultados</h2>

          <tal:gen tal:condition="gen">
            <h3 class="mb-0" i18n:translate="">General</h3>
            <div tal:content="structure gen">-</div>
          </tal:gen>

          <tal:qc tal:condition="qc">
            <h3 class="mb-0">Química clínica</h3>
            <div tal:content="structure qc">-</div>
          </tal:qc>

          <tal:dept tal:condition="has_dept">
            <tal:loop tal:repeat="item dept_items">
              <h3 class="mb-0" tal:content="python:item.get('title') or u'Departamento'">Departamento</h3>
              <div tal:content="structure python:item.get('text')">-</div>
            </tal:loop>
          </tal:dept>
        </div>
      </div>
    </tal:interp>

    <!-- ===== Cola del informe: Firmas + Observaciones ===== -->
    <div class="tail-pack">
      <div class="section-signatures">
        <tal:t replace="structure python:view.render_signatures(ar, **options)" />
      </div>
      <div class="section-remarks">
        <tal:t replace="structure python:view.render_remarks(ar, **options)" />
      </div>
    </div>

    <!-- Discreeter y pie -->
    <tal:t replace="structure python:view.render_discreeter(ar, **options)" />
    <tal:t replace="structure python:view.render_footer(ar, **options)" />

    <!-- =========== Delta Check (visibilidad: ≥2 SIDs y ≥2 puntos por fila) =========== -->
    <tal:delta define="
      get python:getattr;
      _trv python:getattr(ar, 'restrictedTraverse', None);
      delta python:(_trv and ar.restrictedTraverse('@@infolabsa-delta-check')() or {});
      rows python:(delta and delta.get('rows') or []);

      _series_keys python:lambda r: [
        (
          (hasattr(p,'get') and ((p.get('ms') or p.get('date') or u''))) and
          ((p.get('ms') or p.get('date') or u'') + u'|' + unicode(p.get('sid') or p.get('sample_id') or p.get('id') or u''))
        )
        for p in (r.get('series') or [])
        if (hasattr(p,'get') and (p.get('value') not in (None, u'', u'\u2014')))
      ];

      _row_two_distinct python:lambda r: (
        len([k for i,k in enumerate(_series_keys(r)) if (k not in (None, u'', u'\u2014')) and (k not in _series_keys(r)[:i])]) >= 2
      );

      rows_valid python:[ r for r in rows if _row_two_distinct(r) ];

      _all_sids python:[
        unicode(p.get('sid') or p.get('sample_id') or p.get('id') or u'')
        for r in rows for p in (r.get('series') or [])
        if (hasattr(p,'get') and (p.get('value') not in (None, u'', u'\u2014')))
      ];
      _distinct_sids_count_base python:len(set([s for s in _all_sids if s not in (None, u'', u'\u2014')]));

      _prev_ids_fallback python:set([
        unicode(r.get('prev_sample_id') or u'')
        for r in rows
        if r.get('prev_sample_id') not in (None, u'', u'\u2014')
      ]);
      _cur_sid_fallback python:set([
        unicode(
          (get(ar,'getId',None) and ar.getId()) or
          (hasattr(ar,'id') and ar.id) or
          (get(ar,'getRequestID',None) and ar.getRequestID()) or
          u''
        )
      ]);
      _distinct_sids_count python:(
        _distinct_sids_count_base if _distinct_sids_count_base else len(_prev_ids_fallback | _cur_sid_fallback)
      );

      patient_has_two_sids python:(_distinct_sids_count >= 2);

      hasrows python:(bool(rows_valid) and patient_has_two_sids)
    ">
      <div class="row section-delta no-gutters pagebreak-before" tal:condition="hasrows" id="delta-check-panel">
        <div class="w-100">
          <h2 class="mb-1 section-title" i18n:translate="">Tendencia (Delta check)</h2>
          <div class="small" tal:condition="delta/period_label">
            <span i18n:translate="">Período considerado:</span>
            <strong tal:content="delta/period_label">6 meses</strong>
            &bull; <span i18n:translate="">Fuente:</span> <span i18n:translate="">historial de muestras del paciente</span>
          </div>

          <table class="table table-sm table-condensed mt-1">
            <thead>
              <tr>
                <th i18n:translate="">Analito</th>
                <th i18n:translate="">Actual</th>
                <th i18n:translate="">Analito previo</th>
                <th i18n:translate="">&Delta; vs. previo</th>
                <th i18n:translate="">Tendencia</th>
              </tr>
            </thead>
            <tbody>
              <tal:loop repeat="r rows_valid">
                <tal:calc define="
                  ser python:r.get('series') or [];
                  n python:len(ser);
                  t_last python:(ser and ((hasattr(ser[-1],'get') and (ser[-1].get('ms') or ser[-1].get('date'))) or u'') or u'');
                  t_prev python:((n>=2) and ((hasattr(ser[-2],'get') and (ser[-2].get('ms') or ser[-2].get('date'))) or u'') or u'');
                  has_distinct python:(bool(t_last) and bool(t_prev) and (t_last != t_prev));

                  _now_val_raw python:r.get('value_now');
                  _prev_val_raw python:r.get('prev_value');
                  _now_val python:((_now_val_raw not in (None, u'', u'\u2014')) and float(_now_val_raw) or None);
                  _prev_val python:((_prev_val_raw not in (None, u'', u'\u2014')) and float(_prev_val_raw) or ( (n>=2 and has_distinct) and float(ser[-2].get('value')) or None ));

                  delta_abs_val python:((_now_val is not None and _prev_val is not None) and (_now_val - _prev_val) or None);
                  delta_abs_val_norm python:((delta_abs_val is not None) and (abs(delta_abs_val) < 1e-9 and 0.0 or delta_abs_val) or None);
                  delta_abs_str python:((delta_abs_val_norm is not None) and (u'%+.2f' % delta_abs_val_norm) or u'\u2014');

                  delta_pct_str python:(r.get('delta_pct') or u'N/A');
                  _pct_clean python:((delta_pct_str or u'').replace(u'%', u'').strip());
                  delta_pct_val python:((_pct_clean not in (u'', u'N/A')) and abs(float(_pct_clean)) or None);

                  rcv python:r.get('rcv_pct');
                  has_rcv python:(rcv is not None);
                  rcv_ok python:(has_rcv and (delta_pct_val is not None) and (delta_pct_val <= float(rcv)));

                  dir_sym python:(r.get('delta_dir') or u'');
                  trend_arrow python:((dir_sym==u'\u25b2' or dir_sym==u'\u25b3' or dir_sym==u'\u25b4' or dir_sym==u'\u25b5') and u'\u2191' or (dir_sym==u'\u25bc' or dir_sym==u'\u25bd' or dir_sym==u'\u25be' or dir_sym==u'\u25bf') and u'\u2193' or u'\u2192');

                  prev_val_display python:((_prev_val is not None) and (u'%s' % _prev_val) or u'\u2014');
                  prev_date_display python:( (r.get('prev_date_fmt') not in (None, u'', u'\u2014')) and r.get('prev_date_fmt') or ( (n>=2 and has_distinct) and ( (hasattr(ser[-2],'get') and (ser[-2].get('date') or ser[-2].get('ms'))) or u'' ) or u'\u2014') );
                  prev_id_display python:(r.get('prev_sample_id') or u'\u2014');
                ">
                  <tr>
                    <td>
                      <div><strong tal:content="r/name">Analito</strong></div>
                      <div class="small" tal:condition="python:r.get('unit')" tal:content="python:r.get('unit')">U</div>
                    </td>

                    <td>
                      <div tal:content="python:(_now_val is not None and u'%s' % _now_val) or u'\u2014'">&#8212;</div>
                      <div class="small"
                           tal:content="python:view.to_localized_time(
                             (get(view,'verification_datetime',None) and view.verification_datetime(ar)) or
                             (get(ar,'getDateVerified',None) and ar.getDateVerified()) or
                             (get(ar,'getDatePublished',None) and ar.getDatePublished()) or
                             (get(ar,'getDateReceived',None) and ar.getDateReceived()) or
                             get(ar,'created',None)
                           )">&#8212;</div>
                    </td>

                    <td>
                      <div tal:content="python:prev_val_display">&#8212;</div>
                      <div class="small">
                        <span i18n:translate="">ID</span>:
                        <strong tal:content="python:prev_id_display">&#8212;</strong>
                        &nbsp;|&nbsp;
                        <span tal:content="python:prev_date_display">&#8212;</span>
                      </div>
                    </td>

                    <td>
                      <div class="small" tal:condition="python:r.get('delta_note')" tal:content="python:r.get('delta_note')">&#8212;</div>
                      <div tal:condition="python:(r.get('delta_pct') is not None or delta_abs_val_norm is not None)">
                        <span tal:attributes="class python:(r.get('delta_dir')==u'\u25b2' and 'delta-up' or (r.get('delta_dir')==u'\u25bc' and 'delta-down' or ''))"
                              tal:content="python:u'%s %s (%s)' % ((r.get('delta_dir') or u'\u0394'), (delta_abs_str), (delta_pct_str))">&#916; +0.00 (+0%)</span>
                      </div>
                    </td>

                    <td>
                      <div class="trend-arrow"
                           tal:attributes="class python:u'trend-arrow ' + ((trend_arrow==u'\u2191') and 'trend-up' or (trend_arrow==u'\u2193') and 'trend-down' or 'trend-flat')"
                           tal:content="python:trend_arrow">&#8594;</div>

                      <canvas class="spark"
                              tal:attributes="id python:u'spark-'+(r.get('uid') or unicode(repeat['r'].index))"></canvas>
                      <input type="hidden"
                             tal:attributes="id python:u'spark-data-'+(r.get('uid') or unicode(repeat['r'].index));
                                             value python:u'|'.join([u'%s,%s' % (p.get('date'), p.get('value')) for p in (r.get('series') or [])])" />
                    </td>
                  </tr>
                </tal:calc>
              </tal:loop>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Dibujo de mini-sparklines -->
      <script type="text/javascript" tal:condition="hasrows">
      (function(){
        function parseTime(s){
          if (!s) return 0;
          var st = String(s).trim();
          if (/^\d{9,}$/.test(st)) {
            var num = parseInt(st,10);
            return (st.length<=10) ? (num*1000) : num;
          }
          if (st.indexOf(' ')>0 && st.indexOf('T')<0) st = st.replace(' ', 'T');
          var t = Date.parse(st);
          return isNaN(t) ? 0 : t;
        }
        function drawSpark(canvas, points){
          if (!canvas || !points || points.length<2) return;
          var ctx = canvas.getContext('2d');
          var W = canvas.width, H = canvas.height;
          var xs = points.map(function(p){return p[0];});
          var ys = points.map(function(p){return p[1];});
          var xmin = Math.min.apply(null, xs), xmax = Math.max.apply(null, xs);
          var ymin = Math.min.apply(null, ys), ymax = Math.max.apply(null, ys);
          if (xmin===xmax) { xmin -= 1; xmax += 1; }
          if (ymin===ymax) { ymin -= 1; ymax += 1; }
          var pad = 3;
          var sx = function(x){ return pad + (x - xmin) * (W-2*pad) / (xmax - xmin); };
          var sy = function(y){ return H - pad - (y - ymin) * (H-2*pad) / (ymax - ymin); };
          ctx.clearRect(0,0,W,H);
          ctx.lineWidth = 1;
          ctx.strokeStyle = '#343a40';
          ctx.beginPath();
          ctx.moveTo(sx(points[0][0]), sy(points[0][1]));
          for (var i=1;i<points.length;i++){ ctx.lineTo(sx(points[i][0]), sy(points[i][1])); }
          ctx.stroke();
          var last = points[points.length-1];
          ctx.fillStyle = '#343a40';
          ctx.beginPath();
          ctx.arc(sx(last[0]), sy(last[1]), 2, 0, Math.PI*2, true);
          ctx.fill();
        }
        function parseHiddenSpark(id){
          var el = document.getElementById(id);
          if (!el) return null;
          var raw = (el.value || '').trim();
          if (!raw) return null;
          var pts = raw.split('|').map(function(s){
            var kv = s.split(',');
            var t = parseTime(kv[0]);
            var v = parseFloat(kv[1]);
            return [t, isFinite(v)?v:NaN];
          }).filter(function(p){ return p[0] && isFinite(p[1]); });
          return pts.length ? pts : null;
        }
        function initSparks(){
          var rows = document.querySelectorAll('#delta-check-panel canvas.spark');
          for (var i=0;i<rows.length;i++){
            var c = rows[i];
            if (!c.getAttribute('width'))  c.setAttribute('width', 120);
            if (!c.getAttribute('height')) c.setAttribute('height', 36);
            var uid = c.id.replace('spark-','');
            var pts = parseHiddenSpark('spark-data-'+uid);
            if (pts) drawSpark(c, pts);
          }
        }
        function init(){ initSparks(); }
        if (document.readyState === 'loading'){
          document.addEventListener('DOMContentLoaded', init);
        } else {
          init();
        }
      })();
      </script>
    </tal:delta>
    <!-- =========== FIN: Delta Check =========== -->

    <!-- =========== GRÁFICO DE TENDENCIAS (visibilidad: ≥2 SIDs) =========== -->
    <div class="section-trends"
         tal:define="
           get python:getattr;
           json modules/json;
           _get_trends python:get(view,'get_trends_data', None);
           _trv python:getattr(ar, 'restrictedTraverse', None);
           _delta python:(_trv and ar.restrictedTraverse('@@infolabsa-delta-check')() or {});
           trends_data python:(
             (_get_trends and (callable(_get_trends) and _get_trends() or _get_trends))
             or (_delta and (_delta.get('chart_v2') or _delta.get('chart')))
             or {}
           );
           _series python:(trends_data and trends_data.get('series') or []);
           _pairs_per_series python:[
             [
               (
                 (isinstance(p,(list,tuple)) and (len(p)>1) and
                  (p[0] not in (None, u'', u'\u2014')) and
                  (p[1] not in (None, u'', u'\u2014')) and
                  (p[0], p[1]))
                 or
                 (hasattr(p,'get') and
                  (
                    ( (p.get('ms') or p.get('x') or p.get('date') or u'') +
                      u'|' + unicode(p.get('sid') or p.get('sample_id') or p.get('id') or u'') ),
                    (p.get('y') if (p.get('y') not in (None, u'', u'\u2014')) else None)
                  ))
                 or
                 None
               )
               for p in (s.get('data') or [])
             ]
             for s in _series
           ];
           _all_points python:[
             ( (pp and (pp[0] or u'')), (pp and pp[1]) )
             for ser in _pairs_per_series for pp in ser
             if pp and (pp[0] not in (None, u'', u'\u2014')) and (pp[1] not in (None, u'', u'\u2014'))
           ];
           _distinct_points python:len(set([unicode(k) for (k,_) in _all_points]));

           _all_sids python:[
             unicode((p.get('sid') or p.get('sample_id') or p.get('id') or u''))
             for s in _series for p in (s.get('data') or [])
             if (hasattr(p,'get') and (p.get('y') not in (None, u'', u'\u2014')))
           ];
           _distinct_sids_base python:len(set([s for s in _all_sids if s not in (None, u'', u'\u2014')]));

           _delta_rows python:(_delta.get('rows') or []);
           _delta_prev_ids python:set([
             unicode(r.get('prev_sample_id') or u'')
             for r in _delta_rows
             if (hasattr(r,'get') and r.get('prev_sample_id') not in (None, u'', u'\u2014'))
           ]);
           _rid_current python:(
             (get(ar,'getId',None) and ar.getId()) or
             (hasattr(ar,'id') and ar.id) or
             (get(ar,'getRequestID',None) and ar.getRequestID()) or
             options.get('rid','') or u''
           );
           _sid_current_set python:set([unicode(_rid_current)]);
           _distinct_sids_fallback_count python:len(_delta_prev_ids | _sid_current_set);
           _distinct_sids python:(_distinct_sids_base if _distinct_sids_base else _distinct_sids_fallback_count);

           has_two_points python:(_distinct_points >= 2);
           has_two_sids python:(_distinct_sids >= 2)
         "
         tal:condition="python:has_two_sids"> <!-- AJUSTE 1: mostrar si hay ≥2 SIDs, aunque sean del mismo día -->

      <!-- Contenedor para Highcharts (solo navegador) -->
      <div class="chart-center-wrap no-weasyprint">
        <div id="trends-chart-container" class="chart-container no-weasyprint"></div>
      </div>

      <!-- Fallback (PNG) para PDF/WeasyPrint) -->
      <div class="weasy-fallback"
           tal:define="
             get python:getattr;
             ar_uid python:(
               (get(ar,'UID',None) and ar.UID()) or
               (get(ar,'getUID',None) and ar.getUID()) or
               (get(model,'UID',None) and model.UID()) or
               options.get('uid','')
             );
             rid python:(
               (get(ar,'getId',None) and ar.getId()) or
               (hasattr(ar,'id') and ar.id) or
               (get(ar,'getRequestID',None) and ar.getRequestID()) or
               options.get('rid','')
             );
           ">
        <h2 class="section-title">Tendencias de Resultados en el Tiempo</h2>
        <div class="fallback-message">
          <img alt="Gráfico de tendencias (PNG)"
               style="width:180mm; height:auto;"
               tal:attributes="
                 src python:ar.restrictedTraverse('@@infolabsa-trend-chart-datauri')(
                   uid=ar_uid, rid=rid,
                   w=680, h=340, dpi=96,
                   scale=3,
                   max_points=6, days=365,
                   note=1,
                   even=1,
                   sharpen=1
                 )" />
        </div>
      </div>

      <script type="text/javascript">
        (function() {
          if (typeof window.WeasyPrint === 'undefined') {
            var trendsData = <tal:span tal:replace="python:json.dumps(trends_data)" />;
            // Inyectamos también las filas del Delta Check para fallback local (sin fetch)
            var DELTA_ROWS = <tal:span tal:replace="python:json.dumps(_delta_rows)" />;

            if (!trendsData || !trendsData.series || !trendsData.series.length) {
              trendsData = trendsData || {};
              trendsData.series = trendsData.series || [];
            }

            // Contar puntos distintos considerando (x|sid) y con fallback por índice
            var seen = {};
            var distinct = 0;
            try {
              (trendsData.series || []).forEach(function(s){
                var d = (s && s.data) ? s.data : [];
                for (var i=0; i<d.length; i++){
                  var p = d[i];
                  var x = (p && typeof p === 'object')
                            ? (Array.isArray(p) ? p[0] : (p.x || p.ms || p.date || i))
                            : i;
                  var y = (p && typeof p === 'object')
                            ? (Array.isArray(p) ? p[1] : p.y)
                            : p;
                  var sid = (p && typeof p === 'object' && !Array.isArray(p))
                              ? (p.sid || p.sample_id || p.id || '')
                              : '';
                  var key = String(x) + '|' + String(sid || i); // AJUSTE 2: desempate por SID, fallback por índice
                  if (y !== null && y !== undefined && y !== '' && isFinite(parseFloat(y))) {
                    if (!seen[key]) { seen[key] = true; distinct++; }
                  }
                }
              });
            } catch(e) { distinct = 0; }

            // Fallback: si sigue habiendo <2 puntos, construimos trendsData desde DELTA_ROWS con resolución de hora:minuto:segundo
            if (distinct < 2 && Array.isArray(DELTA_ROWS) && DELTA_ROWS.length) {
              try {
                // 1) Recolectar puntos por analito con (ms,y,sid)
                var byAnalyte = {}; // name -> {unit, pts:[{ms,y,sid}]}
                DELTA_ROWS.forEach(function(r){
                  var name = r && r.name ? String(r.name) : '';
                  if (!name) return;
                  var unit = r.unit || (r.rcv_unit || '');
                  var ser = Array.isArray(r.series) ? r.series : [];
                  ser.forEach(function(p){
                    if (!p || typeof p !== 'object') return;
                    var ms = p.ms;
                    if (!ms) {
                      var ds = p.date || p.x || '';
                      if (ds && typeof ds === 'string') {
                        if (ds.indexOf(' ')>0 && ds.indexOf('T')<0) ds = ds.replace(' ', 'T');
                        var parsed = Date.parse(ds);
                        if (!isNaN(parsed)) ms = parsed;
                      }
                    }
                    var y = (p.value != null) ? p.value : p.y;
                    var val = parseFloat(y);
                    if (!ms || !isFinite(val)) return;
                    var sid = p.sid || p.sample_id || p.id || '';
                    if (!byAnalyte[name]) byAnalyte[name] = { unit: unit, pts: [] };
                    byAnalyte[name].pts.push({ ms: ms, y: val, sid: sid });
                  });
                });

                // 2) Eje X: únicos timestamps ordenados (permite múltiples del mismo día)
                var xs = [];
                Object.keys(byAnalyte).forEach(function(k){
                  byAnalyte[k].pts.forEach(function(p){ xs.push(p.ms); });
                });
                xs = Array.from(new Set(xs)).sort(function(a,b){ return a-b; });

                // 3) Si logramos ≥2 timestamps, armamos categorías y series
                if (xs.length >= 2) {
                  function fmt(ts){
                    var d = new Date(ts);
                    function pad(n){ return (n<10?'0':'')+n; }
                    // dd/MM HH:mm (día/mes hora:min)
                    return pad(d.getDate())+'/'+pad(d.getMonth()+1)+' '+pad(d.getHours())+':'+pad(d.getMinutes());
                  }
                  var cats = xs.map(fmt);

                  var builtSeries = Object.keys(byAnalyte).map(function(k){
                    var a = byAnalyte[k];
                    // Para cada timestamp, tomamos el último punto (si hubiese múltiples del mismo analito exactamente a la misma ms)
                    var data = xs.map(function(ms, idx){
                      // buscar punto con ese ms
                      var found = null;
                      for (var i = 0; i < a.pts.length; i++){
                        if (a.pts[i].ms === ms) { found = a.pts[i]; }
                      }
                      return [idx, found ? found.y : null];
                    });
                    var s = { name: k, data: data };
                    if (a.unit) s.unit = a.unit;
                    return s;
                  });

                  // preservamos título/unidad global si existe
                  trendsData = {
                    title: trendsData.title || 'Tendencias de Resultados',
                    unit: trendsData.unit || '',
                    categories: cats,
                    series: builtSeries
                  };
                  distinct = xs.length; // ya garantizado ≥2
                }
              } catch(e) {
                // si hay cualquier inconveniente, dejamos que opere el fallback PNG
              }
            }

            // Si seguimos sin 2 puntos, no se dibuja Highcharts; el PNG queda visible
            if (distinct < 2 || !trendsData.series || !trendsData.series.length) return;

            var cats = trendsData.categories || [];
            var n = cats.length || 0;
            var series = (trendsData.series || []).map(function(s){
              var d = s.data || [];
              var mapped = d.map(function(p, i){
                if (Array.isArray(p)) { return [p[0], p[1]]; }
                var y = (p && typeof p === 'object') ? p.y : p;
                return [i, y];
              });
              var copy = Object.assign({}, s);
              copy.data = mapped;
              return copy;
            });

            var step = (n <= 6) ? 1 : Math.ceil(n / 6);
            var tickPositions = n ? Array.from({length:n}, function(_,i){return i;}) : undefined;

            var options = {
              chart: { type: 'line', height: 560, backgroundColor: 'transparent', spacingTop: 60, spacingBottom: 16, marginTop: 60 },
              title: { text: (trendsData.title || 'Tendencias de Resultados'), margin: 12,
                       style: { color: '#000', fontWeight: 'bold', fontSize: '16px', fontFamily: 'Arial, sans-serif' } },
              subtitle: { text: 'Se muestran puntos ordenados por fecha y hora.', y: 30,
                          style: { color: '#6c757d', fontSize: '12px' } },
              xAxis: {
                categories: cats,
                tickPositions: tickPositions,
                labels: { style: { color: '#333' }, rotation: -45, step: step },
                title: { text: 'Fecha/Hora', style: { color: '#000', fontWeight: 'bold' } },
                tickmarkPlacement: 'on'
              },
              yAxis: {
                title: { text: 'Valores' + (trendsData.unit ? ' (' + trendsData.unit + ')' : ''), style: { color: '#000', fontWeight: 'bold' } },
                labels: { style: { color: '#333' } },
                min: trendsData.yMin,
                max: trendsData.yMax,
                gridLineColor: '#f0f0f0'
              },
              legend: { enabled: true, layout: 'horizontal', align: 'center', verticalAlign: 'bottom', y: 0,
                        itemStyle: { color: '#333', fontWeight: 'normal', fontFamily: 'Arial, sans-serif' } },
              plotOptions: {
                line: {
                  marker: { enabled: true, radius: 4 },
                  dataLabels: {
                    enabled: true,
                    formatter: function(){
                      var u = (this.series && this.series.userOptions && this.series.userOptions.unit) ? (' ' + this.series.userOptions.unit) : '';
                      return (this.y != null) ? Highcharts.numberFormat(this.y, 2).replace(/\.00$/, '') + u : '';
                    },
                    style: { textOutline: '1px contrast' }
                  },
                  enableMouseTracking: true
                }
              },
              tooltip: {
                shared: true, crosshairs: true,
                formatter: function() {
                  var idx = (this.points && this.points.length) ? this.points[0].point.x : (this.point && this.point.x);
                  var fecha = cats && cats[idx] ? cats[idx] : (this.x || '');
                  var s = '<b>' + fecha + '</b>';
                  this.points.forEach(function(p) {
                    var u = (p.series.userOptions && p.series.userOptions.unit) ? (' ' + p.series.userOptions.unit) : '';
                    s += '<br/><span style="color:' + p.color + '">●</span> ' + p.series.name +
                         ': <b>' + Highcharts.numberFormat(p.y, 2).replace(/\.00$/, '') + u + '</b>';
                  });
                  return s;
                }
              },
              series: series,
              credits: { enabled: false },
              exporting: { enabled: false }
            };

            if (typeof Highcharts !== 'undefined') {
              var chart = Highcharts.chart('trends-chart-container', options);
              var el = document.getElementById('trends-chart-container');
              if (el) { el.style.display = 'block'; }
              if (Highcharts.charts && Highcharts.charts.length) {
                var c = Highcharts.charts[Highcharts.charts.length - 1];
                if (c && c.reflow) c.reflow();
              }
              var fb = document.querySelector('.section-trends .weasy-fallback');
              if (fb) fb.style.display = 'none';
              try { document.body.classList.add('has-highcharts'); } catch(e){}
            }
          }
        })();
      </script>
    </div>

    <!-- =========== Anexos (al final, solo si hay contenido) =========== -->
    <tal:attachments_end define="
      get python:getattr;
      atts_html python:(get(view,'render_attachments',None) and view.render_attachments(ar, **options) or u'');
      atts_str  python:(atts_html and (hasattr(atts_html,'strip') and atts_html.strip() or atts_html) or u'');
      atts_lc   python:(isinstance(atts_str, basestring) and atts_str.lower() or unicode(atts_str).lower());
      has_media python:(u'<img' in atts_lc or u'<object' in atts_lc or u'<embed' in atts_lc or u'<figure' in atts_lc or u'<iframe' in atts_lc);
      has_atts_end python:bool(has_media);
      rid python:(
        (get(ar,'getId',None) and ar.getId()) or
        (hasattr(ar,'id') and ar.id) or
        (get(ar,'getRequestID',None) and ar.getRequestID()) or
        options.get('rid','')
      );
    ">
      <div class="attachments-end avoid-break-inside" tal:condition="has_atts_end" style="margin-top:10mm;">
        <h2 class="section-title" style="margin-bottom:6px;">
          <span>Anexos</span>
          <span tal:condition="rid"> — para la muestra: <strong tal:content="rid">ID</strong></span>
        </h2>
        <div class="section-attachments" tal:content="structure atts_html">
          <!-- render_attachments inyecta aquí el contenido -->
        </div>
      </div>
    </tal:attachments_end>

  </div> <!-- cierre del contenedor que define 'ar' -->
</tal:report>
