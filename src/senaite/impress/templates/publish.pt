<!doctype html>
<html xmlns="http://www.w3.org/1999/xhtml"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      i18n:domain="senaite.impress" lang="en">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title i18n:translate="">SENAITE IMPRESS</title>
    <!-- SENAITE IMPRESS HTML head -->
    <div tal:replace="structure provider:senaite.impress.publishhead" />
    <!-- SENANITE IMPRESS Custom HTML head (after impress core resources)  -->
    <div tal:replace="structure provider:senaite.impress.publishcustomhead" />

    <!-- ===================== CUSTOM OVERRIDES: SPINNER EN AZUL ===================== -->
    <style type="text/css">
      /* Azul “salud/laboratorio” (ajústalo si quieres) */
      :root { --impress-blue: #0d6efd; /* Bootstrap Primary */ }

      /* --- Reglas globales existentes (se mantienen) --- */
      .fa-spinner, .fa-circle-notch, .fa-sync, .fa-cog, .fa-gear { color: var(--impress-blue) !important; }
      .fa-spin { color: var(--impress-blue) !important; }
      .spinner-border, .spinner-grow { color: var(--impress-blue) !important; border-color: var(--impress-blue) !important; }
      .spinner-border {
        border-top-color: var(--impress-blue) !important;
        border-right-color: var(--impress-blue) !important;
        border-bottom-color: var(--impress-blue) !important;
        border-left-color: var(--impress-blue) !important;
      }
      .text-danger { color: var(--impress-blue) !important; }
      .impress-spinner, .impress-loading, .report-loading, .loading { color: var(--impress-blue) !important; }

      /* --- Refuerzo con mayor especificidad DENTRO del controlador React --- */
      #publish_controller .text-danger,
      #publish_controller .spinner-border,
      #publish_controller .spinner-grow,
      #publish_controller .fa,
      #publish_controller .fa-spinner,
      #publish_controller .fa-circle-notch,
      #publish_controller .fa-sync,
      #publish_controller .fa-cog,
      #publish_controller .fa-gear,
      #publish_controller .impress-spinner,
      #publish_controller .impress-loading,
      #publish_controller .report-loading,
      #publish_controller .loading,
      #publish_controller [role="status"],
      #publish_controller [aria-busy="true"] {
        color: var(--impress-blue) !important;
        border-color: var(--impress-blue) !important;
      }
      #publish_controller .spinner-border {
        border-top-color: var(--impress-blue) !important;
        border-right-color: var(--impress-blue) !important;
        border-bottom-color: var(--impress-blue) !important;
        border-left-color: var(--impress-blue) !important;
      }
      /* Por si algún theme usa SVG para el spinner */
      #publish_controller svg,
      #publish_controller svg * {
        fill: var(--impress-blue) !important;
        stroke: var(--impress-blue) !important;
      }
    </style>
    <!-- =================== /CUSTOM OVERRIDES: SPINNER EN AZUL ====================== -->

    <!-- =================== CUSTOM OVERRIDES: TRADUCCIÓN + RENOMBRE (SEGURO) =================== -->
    <script type="text/javascript">
      (function () {
        // --- Renombrado de token técnico a nombre visible ---
        function prettyTemplateName(text) {
          if (!text || typeof text !== "string") return text;
          if (text.indexOf("senaite.impress:") === 0) {
            return "infolabsa.pdf:" + text.split(":").slice(1).join(":");
          }
          return text;
        }

        // --- Normaliza elipsis HTML a "..." ASCII para evitar &#8230; en la UI ---
        function normalizeEllipsis(str) {
          if (!str) return str;
          return str.replace(/&#8230;|&hellip;/gi, "...");
        }

        // --- Diccionario de traducciones (usa "..." ASCII) ---
        var DICTIONARY = [
          // ESPECÍFICO solicitado (loading reports)
          {en: /(loading\s*reports?)/i,        es: "Cargando informe de laboratorio..."},
          {en: /(cargando\s*report(?:es)?)/i,  es: "Cargando informe de laboratorio..."},

          // Preview/render
          {en: /rendering preview/i,           es: "Generando vista previa..."},
          {en: /loading preview/i,             es: "Cargando vista previa..."},
          {en: /generating preview/i,          es: "Generando vista previa..."},

          // PDF / Report building
          {en: /generating pdf/i,              es: "Generando PDF..."},
          {en: /creating pdf/i,                es: "Creando PDF..."},
          {en: /building pdf/i,                es: "Construyendo PDF..."},
          {en: /creating report/i,             es: "Creando informe..."},
          {en: /building report/i,             es: "Construyendo informe..."},
          {en: /preparing report/i,            es: "Preparando informe..."},

          // Save / Email / Publish
          {en: /saving reports?/i,             es: "Guardando reportes..."},
          {en: /save reports?/i,               es: "Guardar reportes"},
          {en: /\bsave\b/i,                    es: "Guardar"},
          {en: /send(ing)? emails?/i,          es: "Enviando correos..."},
          {en: /send by email/i,               es: "Enviar por correo"},
          {en: /email reports?/i,              es: "Enviar por correo"},
          {en: /\bemail\b/i,                   es: "Correo"},
          {en: /publish/i,                     es: "Publicar"},
          {en: /republish/i,                   es: "Republicar"},
          {en: /unpublish/i,                   es: "Despublicar"},

          // Acciones / Botones comunes
          {en: /download(?: pdf)?/i,           es: "Descargar PDF"},
          {en: /\bdownload\b/i,                es: "Descargar"},
          {en: /print/i,                       es: "Imprimir"},
          {en: /preview/i,                     es: "Vista previa"},
          {en: /close/i,                       es: "Cerrar"},
          {en: /cancel/i,                      es: "Cancelar"},
          {en: /apply/i,                       es: "Aplicar"},
          {en: /\bok\b/i,                      es: "Aceptar"},
          {en: /confirm/i,                     es: "Confirmar"},
          {en: /retry|try again/i,             es: "Reintentar"},
          {en: /refresh|reload/i,              es: "Recargar"},
          {en: /open/i,                        es: "Abrir"},

          // General
          {en: /please wait/i,                 es: "Por favor, espera..."},
          {en: /loading/i,                     es: "Cargando..."},
          {en: /processing/i,                  es: "Procesando..."}
        ];

        function translateString(str) {
          if (!str) return str;
          var s = prettyTemplateName(normalizeEllipsis(str));
          for (var i = 0; i < DICTIONARY.length; i++) {
            s = s.replace(DICTIONARY[i].en, DICTIONARY[i].es);
          }
          return s;
        }

        // ---- traducción no intrusiva (sin tocar value/placeholder) ----
        var MARK = "data-i18n-done";
        var SAFE_ATTRS = ["title","aria-label","aria-title","data-original-title"]; // ⚠️ SIN value/placeholder

        function translateElement(el) {
          if (!el || el.nodeType !== 1) return;
          if (el.hasAttribute(MARK)) return;

          // atributos “seguros”
          for (var i=0;i<SAFE_ATTRS.length;i++){
            var a = SAFE_ATTRS[i];
            if (el.hasAttribute(a)) {
              var v = el.getAttribute(a);
              var nv = translateString(v);
              if (nv !== v) el.setAttribute(a, nv);
            }
          }

          // sólo nodos de texto directos (no inputs controlados)
          if (!/^(INPUT|TEXTAREA|SELECT)$/i.test(el.tagName)) {
            for (var j=0;j<el.childNodes.length;j++){
              var n = el.childNodes[j];
              if (n.nodeType === 3) {
                var oldT = n.nodeValue;
                var newT = translateString(oldT);
                if (newT !== oldT) n.nodeValue = newT;
              }
            }
          }
          el.setAttribute(MARK, "1");
        }

        function walk(root){
          if (!root) return;
          if (root.nodeType === 1) translateElement(root);
          var q = root.querySelectorAll && root.querySelectorAll("*:not(["+MARK+"])");
          if (!q) return;
          for (var i=0;i<q.length;i++) translateElement(q[i]);
        }

        // Observer con “candado” para evitar bucles de render
        var mo, locked = false;
        function withLock(fn){ if (locked) return; locked = true; try { fn(); } finally { locked = false; } }
        function onMutations(muts){
          if (locked) return;
          withLock(function(){
            for (var i=0;i<muts.length;i++){
              var m = muts[i];
              if (m.type === "childList") {
                for (var j=0;j<m.addedNodes.length;j++){
                  var n = m.addedNodes[j];
                  if (n.nodeType === 1) walk(n);
                }
              } else if (m.type === "attributes") {
                if (SAFE_ATTRS.indexOf(m.attributeName)!==-1) translateElement(m.target);
              }
            }
          });
        }

        function setup() {
          var host = document.getElementById("publish_controller") || document;
          walk(host);
          mo = new MutationObserver(onMutations);
          mo.observe(host, {subtree:true, childList:true, attributes:true, attributeFilter: SAFE_ATTRS});
        }

        if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", setup);
        else setup();
      })();
    </script>
    <!-- ================= /CUSTOM OVERRIDES: TRADUCCIÓN + RENOMBRE (SEGURO) ================== -->

    <!-- /END -->

    <!-- CUSTOM JS
         N.B. we render the JS inline, because traversal seems to not work for plone:static resouces!
    -->
    <tal:custom_js repeat="script view/get_custom_javascripts">
      <!-- <tal:t replace="script/filename"/> -->
      <script type="text/javascript" tal:content="script/filecontents"></script>
    </tal:custom_js>
    <!-- /CUSTOM JS -->
  </head>
  <body>
    <div class="container">
      <div class="card my-4 p-4">

        <div class="row">
          <div class="col-sm-12 text-right">
            <!-- Viewlet manager: publish top -->
            <div tal:replace="structure provider:senaite.impress.publishtop" />
          </div>
        </div>

        <div class="row">
          <div class="col-sm-12">
            <!-- Viewlet manager: report header -->
            <div tal:replace="structure provider:senaite.impress.publishcontent" />
          </div>
        </div>

        <!-- ReactJS controlled component -->
        <div class="row" id="publish_controller"></div>

      </div> <!-- /card -->
    </div> <!-- /container -->

    <!-- ====== OVERRIDE FINAL (máxima prioridad en el DOM) ====== -->
    <style id="infolabsa-spinner-override-final">
      :root { --impress-blue: #0d6efd; }
      body .container .card .spinner-border,
      body .container .card .spinner-grow,
      body .container .card .fa-spinner,
      body .container .card .fa-circle-notch,
      body .container .card .fa-sync,
      body .container .card .fa-cog,
      body .container .card .fa-gear,
      body .container .card [role="status"],
      body .container .card [aria-busy="true"] {
        color: var(--impress-blue) !important;
        border-color: var(--impress-blue) !important;
        border-top-color: var(--impress-blue) !important;
        border-right-color: var(--impress-blue) !important;
        border-bottom-color: var(--impress-blue) !important;
        border-left-color: var(--impress-blue) !important;
        fill: var(--impress-blue) !important;
        stroke: var(--impress-blue) !important;
      }
      body .container .card .text-danger,
      body .container .card [class*="text-danger"] {
        color: var(--impress-blue) !important;
      }
      body .container .card svg,
      body .container .card svg * {
        fill: var(--impress-blue) !important;
        stroke: var(--impress-blue) !important;
      }
    </style>

    <!-- Refuerzo dinámico: si React reinyecta 'text-danger' o spinners nuevos, los azuleamos -->
    <script>
      (function(){
        var BLUE = '#0d6efd';
        var SELECTOR =
          '.spinner-border, .spinner-grow, .fa-spinner, .fa-circle-notch, .fa-sync, .fa-cog, .fa-gear, [role="status"], [aria-busy="true"]';

        function blueify(el){
          if(!el || el.nodeType!==1) return;

          // Quita clases que fuerzan rojo
          if (el.classList) {
            el.classList.remove('text-danger','btn-danger');
            el.classList.add('text-primary');
          }

          // Estilos inline (ganan por prioridad)
          el.style.setProperty('color', BLUE, 'important');
          el.style.setProperty('border-color', BLUE, 'important');
          el.style.setProperty('border-top-color', BLUE, 'important');
          el.style.setProperty('border-right-color', BLUE, 'important');
          el.style.setProperty('border-bottom-color', BLUE, 'important');
          el.style.setProperty('border-left-color', BLUE, 'important');

          // SVG internos
          var svgs = el.querySelectorAll && el.querySelectorAll('svg, svg *');
          if (svgs && svgs.length) {
            for (var i = 0; i < svgs.length; i++) {
              svgs[i].style.setProperty('fill', BLUE, 'important');
              svgs[i].style.setProperty('stroke', BLUE, 'important');
            }
          }
        }

        function scan(root){
          if(!root) return;
          if(root.matches && root.matches(SELECTOR)) blueify(root);
          if(root.querySelectorAll){
            var q = root.querySelectorAll(SELECTOR + ', .text-danger, [class*="text-danger"]');
            for(var i=0;i<q.length;i++) blueify(q[i]);
          }
        }

        // Mantener nuestro <style> final como el último del <head> (por si entran bundles tarde)
        var FINAL_STYLE_ID = 'infolabsa-spinner-override-final';
        function pinStyleAsLast(){
          var s = document.getElementById(FINAL_STYLE_ID);
          if(!s) return;
          var head = document.head || document.getElementsByTagName('head')[0];
          if (s.parentNode !== head || head.lastChild !== s) head.appendChild(s);
        }

        function init(){
          pinStyleAsLast();
          var headMO = new MutationObserver(pinStyleAsLast);
          headMO.observe(document.head || document.documentElement, {childList:true, subtree:true});

          var host = document.getElementById('publish_controller') || document;
          scan(host);

          // Observa mutaciones en el controlador React
          var mo = new MutationObserver(function(muts){
            for(var i=0;i<muts.length;i++){
              var m = muts[i];
              if(m.type==='childList'){
                for(var j=0;j<m.addedNodes.length;j++) scan(m.addedNodes[j]);
              } else if(m.type==='attributes'){
                if (m.attributeName === 'class' || m.attributeName === 'style' || m.attributeName === 'aria-busy' || m.attributeName === 'role') {
                  blueify(m.target);
                }
              }
            }
          });
          mo.observe(host, {subtree:true, childList:true, attributes:true, attributeFilter:['class','style','aria-busy','role']});

          // Reintentos cortos por si algún bundle parchea en siguientes ticks
          setTimeout(function(){ scan(host); pinStyleAsLast(); }, 0);
          setTimeout(function(){ scan(host); pinStyleAsLast(); }, 50);
          setTimeout(function(){ scan(host); pinStyleAsLast(); }, 250);
        }

        if(document.readyState==='loading') document.addEventListener('DOMContentLoaded', init);
        else init();
      })();
    </script>

    <!-- Apaga loaders/overlays cuando llega la vista previa (seguro, enganchando red y DOM) -->
    <script>
      (function(){
        var HOST = document.getElementById('publish_controller') || document;

        // selectores ampliados (incluye overlays frecuentes)
        var SPINNER_SEL = [
          '.spinner-border','.spinner-grow','.fa-spinner','.fa-circle-notch','.fa-sync','.fa-cog','.fa-gear',
          '.impress-loading','.report-loading','.loading','[aria-busy="true"]',
          '.loading-overlay','.overlay','.modal-backdrop'
        ].join(',');

        function hideSpinners(){
          var reportReady = !!HOST.querySelector('.report');
          if (!reportReady) return;
          var nodes = HOST.querySelectorAll(SPINNER_SEL);
          for (var i=0;i<nodes.length;i++){
            var n = nodes[i];
            n.setAttribute('aria-busy','false');
            n.style.display = 'none';
            n.classList.remove('impress-loading','report-loading','loading','text-danger','btn-danger');
          }
        }

        // 1) Si la preview ya está, apaga
        setTimeout(hideSpinners, 0);
        setTimeout(hideSpinners, 300);
        setTimeout(hideSpinners, 1000);

        // 2) Apaga cuando detectemos que carga la preview por red (XHR/fetch)
        function hookXHR(){
          if (!window.XMLHttpRequest) return;
          var _open = XMLHttpRequest.prototype.open;
          var _send = XMLHttpRequest.prototype.send;
          XMLHttpRequest.prototype.open = function(method, url){
            this.__isPreview = /\/ajax_publish\/load_preview\b/.test(url || '');
            return _open.apply(this, arguments);
          };
          XMLHttpRequest.prototype.send = function(){
            if (this.__isPreview) {
              this.addEventListener('load', function(){
                if (this.status>=200 && this.status<300) {
                  setTimeout(hideSpinners, 0);
                  setTimeout(hideSpinners, 150);
                }
              });
            }
            return _send.apply(this, arguments);
          };
        }

        function hookFetch(){
          if (!window.fetch) return;
          var _fetch = window.fetch;
          window.fetch = function(){
            var args = Array.prototype.slice.call(arguments);
            var url = (args[0] && args[0].url) || args[0] || '';
            var isPreview = /\/ajax_publish\/load_preview\b/.test(url);
            return _fetch.apply(this, args).then(function(res){
              if (isPreview && res && res.ok) {
                setTimeout(hideSpinners, 0);
                setTimeout(hideSpinners, 150);
              }
              return res;
            });
          };
        }

        hookXHR();
        hookFetch();

        // 3) Por si la .report entra por DOM sin enganchar red
        new MutationObserver(function(muts){
          for (var i=0;i<muts.length;i++){
            var m = muts[i];
            if (m.type==='childList') {
              for (var j=0;j<m.addedNodes.length;j++){
                var n = m.addedNodes[j];
                if (n.nodeType===1 && (n.matches?.('.report') || n.querySelector?.('.report'))) {
                  hideSpinners();
                  return;
                }
              }
            }
          }
        }).observe(HOST, {subtree:true, childList:true});
      })();
    </script>
    <!-- ====== /OVERRIDE FINAL ====== -->
  </body>
</html>
