<!doctype html>
<html xmlns="http://www.w3.org/1999/xhtml"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      i18n:domain="senaite.impress" lang="en">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title i18n:translate="">SENAITE IMPRESS</title>
    <!-- SENAITE IMPRESS HTML head -->
    <div tal:replace="structure provider:senaite.impress.publishhead" />
    <!-- SENANITE IMPRESS Custom HTML head (after impress core resources)  -->
    <div tal:replace="structure provider:senaite.impress.publishcustomhead" />

    <!-- ===== Spinner color (CSS “suave”; mantenemos/ajustado) ===== -->
    <style>
      :root { --impress-blue: #0d6efd; }

      /* Recolorea SOLO spinners conocidos dentro del publish controller */
      #publish_controller .spinner-border,
      #publish_controller .spinner-grow,
      #publish_controller .fa-spinner,
      #publish_controller .fa-circle-notch,
      #publish_controller .fa-sync,
      #publish_controller .fa-cog,
      #publish_controller .fa-gear {
        color: var(--impress-blue);
      }

      /* Cuando el rojo entra por text-danger */
      #publish_controller .spinner-border.text-danger,
      #publish_controller .spinner-grow.text-danger,
      #publish_controller .fa-spinner.text-danger,
      #publish_controller .fa-circle-notch.text-danger,
      #publish_controller .text-danger .spinner-border,
      #publish_controller .text-danger .spinner-grow,
      #publish_controller .text-danger .fa-spinner,
      #publish_controller .text-danger .fa-circle-notch {
        color: var(--impress-blue) !important;
      }

      /* SVG internos (FA en modo SVG) */
      #publish_controller .spinner-border svg,
      #publish_controller .spinner-border svg *,
      #publish_controller .spinner-grow svg,
      #publish_controller .spinner-grow svg *,
      #publish_controller .fa-spinner svg,
      #publish_controller .fa-spinner svg * {
        stroke: var(--impress-blue);
        fill: var(--impress-blue);
      }

      /* Bootstrap spinner-border usa bordes */
      #publish_controller .spinner-border,
      #publish_controller .spinner-border.text-danger {
        border-color: var(--impress-blue) !important;
        border-top-color: var(--impress-blue) !important;
      }

      /* ===== Variantes lds-* y folding (por si las usa el bundle) ===== */
      #publish_controller .lds-dual-ring:after { border-color: currentColor transparent currentColor transparent !important; }
      #publish_controller .lds-ripple div { border-color: currentColor !important; }
      #publish_controller .lds-spinner div:after { background: currentColor !important; }
      #publish_controller .lds-grid div,
      #publish_controller .lds-ellipsis div,
      #publish_controller .lds-facebook div { background: currentColor !important; }
      #publish_controller .folding .sk-cube:before { background-color: var(--impress-blue) !important; }
    </style>
    <!-- ============================================ -->

    <!-- =================== CUSTOM OVERRIDES: TRADUCCIÓN + RENOMBRE (SEGURO) =================== -->
    <script type="text/javascript">
      (function () {
        function prettyTemplateName(text) {
          if (!text || typeof text !== "string") return text;
          if (text.indexOf("senaite.impress:") === 0) {
            return "infolabsa.pdf:" + text.split(":").slice(1).join(":");
          }
          return text;
        }
        function normalizeEllipsis(str) { if (!str) return str; return str.replace(/&#8230;|&hellip;/gi, "..."); }
        function normalizeSpaces(str){ return (str||"").replace(/\s+/g," ").trim(); }

        /* NUEVO: decodificador de entidades HTML (&aacute;, &#243;, etc.) */
        var _ta;
        function decodeEntities(str){
          if (!str) return str;
          _ta = _ta || document.createElement('textarea');
          _ta.innerHTML = str;
          return _ta.value;
        }

        /* 1) Frases COMPLETAS primero (ancladas para evitar parciales) */
        var PHRASES = [
          { en: /^Share PDF via email$/i,
            es: "Compartir PDF por correo electrónico" },
          { en: /^Download the generated PDF to your computer$/i,
            es: "Descargar el PDF generado en tu equipo" }
        ];

        /* 2) Reglas GENÉRICAS después */
        var GENERICS = [
          {en: /\b(rendering|generating)\s+preview\b/i,           es: "Generando vista previa..."},
          {en: /\b(loading)\s+(the\s+)?preview\b/i,               es: "Cargando vista previa..."},
          {en: /\b(preview)\s+loading\b/i,                        es: "Cargando vista previa..."},
          {en: /\b(building|creating|preparing)\s+preview\b/i,    es: "Preparando vista previa..."},
          {en: /\b(generating|creating|building)\s+pdf\b/i,       es: "Generando PDF..."},
          {en: /\b(preparing|building|creating)\s+report\b/i,     es: "Preparando informe..."},
          {en: /\b(loading)\s*reports?\b/i,                       es: "Cargando informe de laboratorio..."},
          {en: /\b(fetching|loading)\s+(data|resources)\b/i,      es: "Cargando datos..."},
          {en: /\b(processing|calculating|computing)\b/i,         es: "Procesando..."},
          {en: /\b(initializing|starting|bootstrapping)\b/i,      es: "Inicializando..."},
          {en: /\b(queue(?:d|ing)?)\b/i,                          es: "En cola..."},
          {en: /\b(finalizing|finishing|wrapping up)\b/i,         es: "Finalizando..."},
          {en: /\b(please\s*wait)\b/i,                            es: "Por favor, espera..."},
          {en: /\bloading\b/i,                                    es: "Cargando..."},
          {en: /\bworking\b/i,                                    es: "Trabajando..."},
          {en: /\bupdating\b/i,                                   es: "Actualizando..."},
          {en: /\bsaving\s+reports?\b/i,                          es: "Guardando reportes..."},
          {en: /\bsave\s+reports?\b/i,                            es: "Guardar reportes"},
          {en: /\bsave\b/i,                                       es: "Guardar"},
          {en: /\bsending?\s+emails?\b/i,                         es: "Enviando correos..."},
          {en: /\bsend\s+by\s+email\b/i,                          es: "Enviar por correo"},
          {en: /\bemail\s+reports?\b/i,                           es: "Enviar por correo"},
          {en: /\bemail\b/i,                                      es: "Correo"},
          {en: /\bpublish\b/i,                                    es: "Publicar"},
          {en: /\brepublish\b/i,                                  es: "Republicar"},
          {en: /\bunpublish\b/i,                                  es: "Despublicar"},
          {en: /\bdownload(?:\s*pdf)?\b/i,                        es: "Descargar PDF"},
          {en: /\bdownload\b/i,                                   es: "Descargar"},
          {en: /\bprint\b/i,                                      es: "Imprimir"},
          {en: /\bpreview\b/i,                                    es: "Vista previa"},
          {en: /\bclose\b/i,                                      es: "Cerrar"},
          {en: /\bcancel\b/i,                                     es: "Cancelar"},
          {en: /\bapply\b/i,                                      es: "Aplicar"},
          {en: /\bok\b/i,                                         es: "Aceptar"},
          {en: /\bconfirm\b/i,                                    es: "Confirmar"},
          {en: /\b(retry|try\s*again)\b/i,                        es: "Reintentar"},
          {en: /\b(refresh|reload)\b/i,                           es: "Recargar"},
          {en: /\bopen\b/i,                                       es: "Abrir"},
          {en: /\blandscape\b/i,                                  es: "Horizontal"},
          {en: /\bportrait\b/i,                                   es: "Vertical"},
          {en: /\borientation\b/i,                                es: "Orientación"},
          {en: /\bpage\s*size\b/i,                                es: "Tamaño de página"},
          {en: /\bpage\s*layout\b/i,                              es: "Diseño de página"},
          {en: /\bplease\s*wait\b/i,                              es: "Por favor, espera..."},
          {en: /\bprocessing\b/i,                                 es: "Procesando..."},
          {en: /\berror\b/i,                                      es: "Error"},
          {en: /\bwarning\b/i,                                    es: "Advertencia"},
          {en: /\bsuccess\b/i,                                    es: "Éxito"}
        ];

        function translateString(str) {
          if (!str) return str;
          var s = prettyTemplateName(normalizeEllipsis(str));
          s = decodeEntities(s);          /* <-- decodifica &#243; &oacute; etc. */
          s = normalizeSpaces(s);

          // 1) Frases completas primero
          for (var i=0; i<PHRASES.length; i++) {
            s = s.replace(PHRASES[i].en, PHRASES[i].es);
          }
          // 2) Reglas genéricas después
          for (var j=0; j<GENERICS.length; j++) {
            s = s.replace(GENERICS[j].en, GENERICS[j].es);
          }
          return s;
        }

        var MARK = "data-i18n-done";
        // Añadimos data-bs-original-title (Bootstrap 5) además de data-original-title (Bootstrap 4)
        var SAFE_ATTRS = ["title","aria-label","aria-title","data-original-title","data-bs-original-title"];

        function translateTextNode(n){
          if (!n || n.nodeType !== 3) return;
          var oldT = n.nodeValue, newT = translateString(n.nodeValue);
          if (newT !== oldT) n.nodeValue = newT;
        }
        function translateElement(el) {
          if (!el || el.nodeType !== 1) return;
          for (var i=0;i<SAFE_ATTRS.length;i++){
            var a = SAFE_ATTRS[i];
            if (el.hasAttribute(a)) {
              var v = el.getAttribute(a), nv = translateString(v);
              if (nv !== v) el.setAttribute(a, nv);  /* atributo queda decodificado */
            }
          }
          if (!/^(INPUT|TEXTAREA|SELECT)$/i.test(el.tagName)) {
            for (var j=0;j<el.childNodes.length;j++){
              var n = el.childNodes[j];
              if (n.nodeType === 3) translateTextNode(n);
            }
          }
          el.setAttribute(MARK, "1");
        }
        function walk(root){
          if (!root) return;
          if (root.nodeType === 1) translateElement(root);
          var q = root.querySelectorAll && root.querySelectorAll("*:not(["+MARK+"])");
          if (!q) return;
          for (var i=0;i<q.length;i++) translateElement(q[i]);
        }

        /* Traducción de tooltips montados en <body> */
        function translateTooltipsInBody() {
          var tips = document.querySelectorAll('.tooltip, .tooltip-inner');
          for (var i=0;i<tips.length;i++) {
            var t = tips[i];
            if (t.classList && t.classList.contains('tooltip-inner')) {
              var old = t.textContent || '';
              var neu = translateString(old);
              if (neu !== old) t.textContent = neu; /* textContent evita re-encode */
            } else {
              translateElement(t);
            }
          }
        }

        var mo, locked = false;
        function withLock(fn){ if (locked) return; locked = true; try { fn(); } finally { locked = false; } }
        function onMutations(muts){
          if (locked) return;
          withLock(function(){
            for (var i=0;i<muts.length;i++){
              var m = muts[i];
              if (m.type === "childList") {
                for (var j=0;j<m.addedNodes.length;j++){
                  var n = m.addedNodes[j];
                  if (n.nodeType === 1) walk(n);
                  else if (n.nodeType === 3) translateTextNode(n);
                }
              } else if (m.type === "attributes") {
                if (SAFE_ATTRS.indexOf(m.attributeName)!==-1) translateElement(m.target);
              } else if (m.type === "characterData") {
                translateTextNode(m.target);
              }
            }
          });
        }
        function setup() {
          var host = document.getElementById("publish_controller") || document;
          walk(host);
          mo = new MutationObserver(onMutations);
          mo.observe(host, {subtree:true, childList:true, attributes:true, characterData:true, attributeFilter: SAFE_ATTRS});

          // Observador global para tooltips (se crean en body)
          var moGlobal = new MutationObserver(function(muts){
            var touched = false;
            for (var i=0;i<muts.length;i++){
              var m = muts[i];
              if (m.type === 'childList') {
                for (var j=0;j<m.addedNodes.length;j++){
                  var n = m.addedNodes[j];
                  if (n.nodeType === 1 && (n.classList?.contains('tooltip') || n.querySelector?.('.tooltip-inner'))) {
                    touched = true;
                  }
                }
              }
            }
            if (touched) translateTooltipsInBody();
          });
          moGlobal.observe(document.documentElement, {subtree:true, childList:true});

          // Eventos Bootstrap (si existen)
          document.addEventListener('shown.bs.tooltip', translateTooltipsInBody, true);
          document.addEventListener('inserted.bs.tooltip', translateTooltipsInBody, true);

          setTimeout(translateTooltipsInBody, 0);
          setTimeout(translateTooltipsInBody, 200);
        }
        if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", setup);
        else setup();
      })();
    </script>
    <!-- ================= /CUSTOM OVERRIDES: TRADUCCIÓN + RENOMBRE (SEGURO) ================== -->

    <!-- /END -->

    <!-- CUSTOM JS -->
    <tal:custom_js repeat="script view/get_custom_javascripts">
      <script type="text/javascript" tal:content="script/filecontents"></script>
    </tal:custom_js>
  </head>
  <body>
    <div class="container">
      <div class="card my-4 p-4">

        <div class="row">
          <div class="col-sm-12 text-right">
            <!-- Viewlet manager: publish top -->
            <div tal:replace="structure provider:senaite.impress.publishtop" />
          </div>
        </div>

        <div class="row">
          <div class="col-sm-12">
            <!-- Viewlet manager: report header -->
            <div tal:replace="structure provider:senaite.impress.publishcontent" />
          </div>
        </div>

        <!-- ReactJS controlled component -->
        <div class="row" id="publish_controller"></div>

      </div>
    </div>

    <!-- ====== LÓGICA: apagar loaders cuando llega la vista previa (sin tocar colores) ====== -->
    <script>
      (function(){
        var HOST = document.getElementById('publish_controller') || document;
        var SPINNER_SEL = [
          '.spinner-border','.spinner-grow','.fa-spinner','.fa-circle-notch','.fa-sync','.fa-cog','.fa-gear',
          '.impress-loading','.report-loading','.loading'
        ].join(',');
        function hideSpinners(){
          var reportReady = !!HOST.querySelector('.report');
          if (!reportReady) return;
          var nodes = HOST.querySelectorAll(SPINNER_SEL);
          for (var i=0;i<nodes.length;i++){
            var n = nodes[i];
            n.setAttribute('aria-busy','false');
            n.style.display = 'none';
            n.classList.remove('impress-loading','report-loading','loading','text-danger','btn-danger');
          }
        }
        setTimeout(hideSpinners, 0);
        setTimeout(hideSpinners, 300);
        setTimeout(hideSpinners, 1000);

        function hookXHR(){
          if (!window.XMLHttpRequest) return;
          var _open = XMLHttpRequest.prototype.open, _send = XMLHttpRequest.prototype.send;
          XMLHttpRequest.prototype.open = function(method, url){
            this.__isPreview = /\/ajax_publish\/load_preview\b/.test(url || '');
            return _open.apply(this, arguments);
          };
          XMLHttpRequest.prototype.send = function(){
            if (this.__isPreview) {
              this.addEventListener('load', function(){
                if (this.status>=200 && this.status<300) {
                  setTimeout(hideSpinners, 0);
                  setTimeout(hideSpinners, 150);
                }
              });
            }
            return _send.apply(this, arguments);
          };
        }
        function hookFetch(){
          if (!window.fetch) return;
          var _fetch = window.fetch;
          window.fetch = function(){
            var args = Array.prototype.slice.call(arguments);
            var url = (args[0] && args[0].url) || args[0] || '';
            var isPreview = /\/ajax_publish\/load_preview\b/.test(url);
            return _fetch.apply(this, args).then(function(res){
              if (isPreview && res && res.ok) {
                setTimeout(hideSpinners, 0);
                setTimeout(hideSpinners, 150);
              }
              return res;
            });
          };
        }
        hookXHR(); hookFetch();

        new MutationObserver(function(muts){
          for (var i=0;i<muts.length;i++){
            var m = muts[i];
            if (m.type==='childList') {
              for (var j=0;j<m.addedNodes.length;j++){
                var n = m.addedNodes[j];
                if (n.nodeType===1 && (n.matches?.('.report') || n.querySelector?.('.report'))) {
                  hideSpinners();
                  return;
                }
              }
            }
          }
        }).observe(HOST, {subtree:true, childList:true});
      })();
    </script>
    <!-- ====== /APAGADO DE LOADERS ====== -->

    <!-- ====== BLUE FIX “DURO” (seguro y no bloqueante) ====== -->
    <script>
      (function(){
        // Si algún bundle mete inline rojo o !important, lo forzamos a azul
        var BLUE = getComputedStyle(document.documentElement).getPropertyValue('--impress-blue').trim() || '#0d6efd';
        var HOST = document.getElementById('publish_controller') || document;
        var SELECTOR = [
          '.spinner-border','.spinner-grow',
          '.fa-spinner','.fa-circle-notch','.fa-sync','.fa-cog','.fa-gear'
        ].join(',');

        function paint(el){
          if (!el || el.nodeType!==1) return;
          // color/base (Bootstrap usa currentColor en spinner-border)
          el.style.setProperty('color', BLUE, 'important');
          el.style.setProperty('border-color', BLUE, 'important');
          el.style.setProperty('border-top-color', BLUE, 'important');
          el.style.setProperty('border-right-color', BLUE, 'important');
          el.style.setProperty('border-bottom-color', BLUE, 'important');
          el.style.setProperty('border-left-color', BLUE, 'important');
          // SVG internos (FA/SVG loaders)
          var svgs = el.querySelectorAll('svg, svg *');
          for (var i=0;i<svgs.length;i++){
            svgs[i].style.setProperty('fill', BLUE, 'important');
            svgs[i].style.setProperty('stroke', BLUE, 'important');
          }
        }
        function scan(root){
          if (!root) return;
          if (root.matches && root.matches(SELECTOR)) paint(root);
          var list = root.querySelectorAll ? root.querySelectorAll(SELECTOR) : [];
          for (var i=0;i<list.length;i++) paint(list[i]);
        }

        // Primeros pases (no bloqueantes)
        requestAnimationFrame(function(){ scan(HOST); });
        setTimeout(function(){ scan(HOST); }, 50);
        setTimeout(function(){ scan(HOST); }, 250);

        // Mantener el azul ante mutaciones (React)
        new MutationObserver(function(muts){
          for (var i=0;i<muts.length;i++){
            var m = muts[i];
            if (m.type === 'childList') {
              for (var j=0;j<m.addedNodes.length;j++) scan(m.addedNodes[j]);
            } else if (m.type === 'attributes') {
              if (m.attributeName === 'class' || m.attributeName === 'style' || m.attributeName === 'aria-busy' || m.attributeName === 'role') {
                paint(m.target);
              }
            }
          }
        }).observe(HOST, {subtree:true, childList:true, attributes:true, attributeFilter:['class','style','aria-busy','role']});
      })();
    </script>
    <!-- ====== /BLUE FIX “DURO” ====== -->

  </body>

<!-- ==== OVERRIDE GLOBAL PARA SPINNERS (publish screen) ==== -->
<style>
  :root { --impress-blue: #0d6efd; }

  /* Alcance ampliado: SOLO spinners conocidos (no roles genéricos) */
  body .spinner-border,
  body .spinner-grow,
  body .fa-spinner,
  body .fa-circle-notch,
  body .fa-sync,
  body .fa-cog,
  body .fa-gear {
    color: var(--impress-blue) !important;
  }

  /* text-danger directo o heredado */
  body .text-danger.fa-spinner,
  body .text-danger.spinner-border,
  body .text-danger.spinner-grow,
  body .text-danger .spinner-border,
  body .text-danger .spinner-grow,
  body .text-danger .fa-spinner,
  body .text-danger .fa-circle-notch {
    color: var(--impress-blue) !important;
  }

  /* SVG (FA en modo SVG) */
  body .spinner-border svg,
  body .spinner-border svg *,
  body .spinner-grow svg,
  body .spinner-grow svg *,
  body .fa-spinner svg,
  body .fa-spinner svg * {
    fill: var(--impress-blue) !important;
    stroke: var(--impress-blue) !important;
  }

  /* Bordes de spinner-border */
  body .spinner-border {
    border-color: var(--impress-blue) !important;
    border-top-color: var(--impress-blue) !important;
  }

  /* Variantes lds-* y folding GLOBAL por si aparecen fuera del controller */
  body .lds-dual-ring:after { border-color: currentColor transparent currentColor transparent !important; }
  body .lds-ripple div { border-color: currentColor !important; }
  body .lds-spinner div:after { background: currentColor !important; }
  body .lds-grid div,
  body .lds-ellipsis div,
  body .lds-facebook div { background: currentColor !important; }
  body .folding .sk-cube:before { background-color: var(--impress-blue) !important; }
</style>

<script>
(function () {
  var BLUE = getComputedStyle(document.documentElement)
               .getPropertyValue('--impress-blue').trim() || '#0d6efd';

  var SELECTOR = [
    '.spinner-border','.spinner-grow',
    '.fa-spinner','.fa-circle-notch','.fa-sync','.fa-cog','.fa-gear'
  ].join(',');

  function paint(el) {
    if (!el || el.nodeType !== 1) return;
    el.style.setProperty('color', BLUE, 'important');
    el.style.setProperty('border-color', BLUE, 'important');
    el.style.setProperty('border-top-color', BLUE, 'important');
    el.style.setProperty('border-right-color', BLUE, 'important');
    el.style.setProperty('border-bottom-color', BLUE, 'important');
    el.style.setProperty('border-left-color', BLUE, 'important');

    var svgs = el.querySelectorAll('svg, svg *');
    for (var i=0; i<svgs.length; i++) {
      svgs[i].style.setProperty('fill', BLUE, 'important');
      svgs[i].style.setProperty('stroke', BLUE, 'important');
    }

    // Si el padre arrastra .text-danger por herencia, neutralízalo
    var p = el.parentElement;
    if (p && /\btext-danger\b/.test(p.className)) {
      p.style.setProperty('color', BLUE, 'important');
    }
  }

  function scan(root) {
    if (!root) return;
    var list = (root.matches && root.matches(SELECTOR)) ? [root] : [];
    var all = root.querySelectorAll ? root.querySelectorAll(SELECTOR) : [];
    for (var i=0; i<all.length; i++) list.push(all[i]);
    for (var j=0; j<list.length; j++) paint(list[j]);
  }

  // Primeros pases
  requestAnimationFrame(function(){ scan(document.body); });
  setTimeout(function(){ scan(document.body); }, 50);
  setTimeout(function(){ scan(document.body); }, 300);

  // Observa mutaciones globales (modales/overlays fuera del controller)
  var mo = new MutationObserver(function(muts){
    for (var i=0; i<muts.length; i++) {
      var m = muts[i];
      if (m.type === 'childList') {
        for (var j=0; j<m.addedNodes.length; j++) scan(m.addedNodes[j]);
      } else if (m.type === 'attributes') {
        if (m.attributeName === 'class' || m.attributeName === 'style' ||
            m.attributeName === 'aria-busy' || m.attributeName === 'role') {
          scan(m.target);
        }
      }
    }
  });
  mo.observe(document.documentElement, {
    subtree: true,
    childList: true,
    attributes: true,
    attributeFilter: ['class','style','aria-busy','role']
  });

})();
</script>
<!-- ==== /OVERRIDE GLOBAL ==== -->

</html>
